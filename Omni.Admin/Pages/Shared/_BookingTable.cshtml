@model IReadOnlyList<BookingRow>
@* Bookings as table rows (Bookings list, contact details). The caller wraps it in .au-table-card. *@
@if (Model.Count == 0)
{
    var empty = new EmptyStateModel(Context.Request.EmptyMessage("bookings"), "event");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="au-table-scroll">
        <table class="au-table">
            <thead>
                <tr><th>When (client time)</th><th>Contact</th><th>Client</th><th>Service</th><th>Status</th><th>Change status</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@Ui.Time(a.ScheduledStart, a.ClientTimezone)</td>
                        <td><a href="/Contacts/Details?id=@a.ContactId">@(string.IsNullOrWhiteSpace(a.ContactName) ? "(no name)" : a.ContactName)</a></td>
                        <td><a href="/Clients/Details?id=@a.ClientId">@a.ClientName</a></td>
                        <td>@(a.ServiceName ?? "—")</td>
                        <td>@Ui.Badge(a.Status)</td>
                        <td>
                            <form class="au-row" style="--au-gap:6px" method="post" action="/Bookings?handler=Status">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <select class="au-select au-select--sm" style="width:170px" name="status" aria-label="New status">@foreach (var s in BookingStatus.All) { <option value="@s" selected="@(s == a.Status)">@s.Replace('_', ' ')</option> }</select>
                                <button class="au-btn au-btn--outlined au-btn--sm" type="submit">Set</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
