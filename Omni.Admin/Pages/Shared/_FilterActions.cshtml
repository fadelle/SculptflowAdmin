@* The end of every filter toolbar: Search, Clear once anything is filtered, and ⟳ Refresh. Selects and checkboxes submit
   on change (site.js, form.filters); text submits with Enter or Search. *@
<button class="au-btn au-btn--outlined" type="submit"><span class="au-icon" aria-hidden="true">search</span>Search</button>
@if (Context.Request.HasFilters())
{
    <a class="au-btn au-btn--text" href="@Context.Request.Path">Clear</a>
}
<button type="button" class="au-icon-btn au-icon-btn--bordered" data-au-refresh data-au-tip="Refresh" aria-label="Refresh">
    <span class="au-icon" aria-hidden="true">refresh</span>
</button>
