@model IReadOnlyList<EventRow>
@* Main-app events as table rows (Event log, contact details). The caller wraps it in .au-table-card. *@
@if (Model.Count == 0)
{
    var empty = new EmptyStateModel(Context.Request.EmptyMessage("events"), "monitor_heart");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="au-table-scroll">
        <table class="au-table">
            <thead>
                <tr><th>When</th><th>Event</th><th>Client</th><th>Source</th><th>Links</th><th>Metadata</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@Ui.Time(e.CreatedAt)</td>
                        <td class="au-strong">@e.EventType.Replace('_', ' ')</td>
                        <td><a href="/Clients/Details?id=@e.ClientId">@e.ClientName</a></td>
                        <td>@e.Source</td>
                        <td>
                            @if (e.ContactId.HasValue) { <a href="/Contacts/Details?id=@e.ContactId">contact</a> }
                            @if (e.ConversationId.HasValue) { <a href="/Conversations/Details?id=@e.ConversationId">conversation</a> }
                            @if (!e.ContactId.HasValue && !e.ConversationId.HasValue) { <span class="au-faint">—</span> }
                        </td>
                        <td class="au-wrap"><span class="au-mono">@(e.Metadata == "{}" ? "" : Ui.Truncate(e.Metadata, 240))</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
