@model IReadOnlyList<ClientRow>
@* Clients as table rows (Clients list, dashboard). The caller wraps it in .au-table-card. *@
@if (Model.Count == 0)
{
    var empty = new EmptyStateModel(Context.Request.EmptyMessage("clients"), "domain");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="au-table-scroll">
        <table class="au-table">
            <thead>
                <tr><th>Client</th><th>Status</th><th>WhatsApp</th><th class="au-right">Members</th><th class="au-right">Contacts</th><th class="au-right">Conversations</th><th>Last message</th><th>Signed up</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr data-au-href="/Clients/Details?id=@c.Id">
                        <td><a href="/Clients/Details?id=@c.Id">@c.Name</a><div class="au-caption">@c.Slug @(c.Email is null ? "" : "· " + c.Email)</div></td>
                        <td>@Ui.Badge(c.IsActive ? "active" : "inactive")</td>
                        <td>@Ui.Badge(c.WhatsAppStatus)</td>
                        <td class="au-right">@c.MemberCount</td>
                        <td class="au-right">@c.ContactCount</td>
                        <td class="au-right">@c.ConversationCount</td>
                        <td>@Ui.Time(c.LastMessageAt)</td>
                        <td>@Ui.Time(c.CreatedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
