@page
@model Omni.Admin.Pages.Channels.TokenDebugModel
@{
    ViewData["Title"] = "WhatsApp token check";
}
<div class="au-page-head">
    <p class="au-page-head__sub">Asks Meta what a WhatsApp access token can do: which permissions it was granted and which client
        WhatsApp business accounts it can see. Use it when the embedded-signup popup skips the phone-number step. Paste either a
        token or the code the popup returned (it is exchanged first). Nothing you paste is stored.</p>
</div>

<section class="au-panel au-panel--round au-panel--pad" style="max-width:720px">
    <form method="post" autocomplete="off">
        <div class="au-form-field">
            <label class="au-form-label" for="td-token">Access token</label>
            <input class="au-input" id="td-token" name="accessToken" type="password" autocomplete="off" spellcheck="false" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="td-code">…or embedded-signup code</label>
            <input class="au-input" id="td-code" name="code" type="password" autocomplete="off" spellcheck="false" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="td-redirect">Redirect URI (only when the code needs one)</label>
            <input class="au-input" id="td-redirect" name="redirectUri" placeholder="https://…" />
        </div>
        <button class="au-btn au-btn--primary" type="submit"><span class="au-icon" aria-hidden="true">key</span>Check with Meta</button>
    </form>
</section>

@if (Model.Error is not null)
{
    <p class="au-text-error" style="margin-top:16px" role="alert">@Model.Error</p>
}

@if (Model.Result is not null)
{
    <div class="au-stack" style="margin-top:16px">
        <section class="au-panel au-panel--round au-panel--pad">
            <div class="au-panel__head"><h3 class="au-panel__title">Granted permissions</h3></div>
            @if (Model.Result.Scopes.Count == 0)
            {
                <p class="au-muted">Meta reported no permissions for this token.</p>
            }
            else
            {
                <ul class="au-list">
                    @foreach (var s in Model.Result.Scopes) { <li class="au-mono">@s</li> }
                </ul>
            }
        </section>
        <section class="au-panel au-panel--round au-panel--pad">
            <div class="au-panel__head"><h3 class="au-panel__title">Client WhatsApp business accounts</h3></div>
            @if (Model.Result.ClientWabas.Count == 0)
            {
                <p class="au-muted">No client WhatsApp business accounts are visible to this token. That is the usual reason the phone-number step is skipped.</p>
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table">
                        <thead><tr><th>Business</th><th>Business id</th><th>WhatsApp account</th><th>Account id</th><th>Relationship</th></tr></thead>
                        <tbody>
                            @foreach (var w in Model.Result.ClientWabas)
                            {
                                <tr>
                                    <td>@w.BusinessName</td>
                                    <td class="au-mono">@w.BusinessId</td>
                                    <td>@w.WabaName</td>
                                    <td class="au-mono">@w.WabaId</td>
                                    <td>@w.Relationship</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}