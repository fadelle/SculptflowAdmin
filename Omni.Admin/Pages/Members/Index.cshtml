@page
@model Omni.Admin.Pages.Members.IndexModel
@{ ViewData["Title"] = "Member accounts"; }
<div class="au-page-head"><p class="au-page-head__sub">Client users of the main app. Admin users are separate (see Admin users).</p></div>
<form class="filters au-toolbar" method="get">
    <div class="au-toolbar__filters">
        <div class="au-field" style="width:260px">
            <label class="au-label" for="f-q">Search</label>
            <span class="au-input-icon"><span class="au-icon" aria-hidden="true">search</span><input class="au-input" type="search" id="f-q" name="q" value="@Model.Q" placeholder="Name or email" /></span>
        </div>
    </div>
    <div class="au-toolbar__actions">
        <span class="au-toolbar__meta">@Ui.Count(Model.Result.Total, "account", "accounts")</span>
        <partial name="_FilterActions" />
    </div>
</form>
<div class="au-table-card">
    @if (Model.Result.Items.Count == 0)
    {
        var empty = new EmptyStateModel(Request.EmptyMessage("member accounts"), "badge");
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="au-table-scroll">
            <table class="au-table">
                <thead>
                    <tr><th>Name</th><th>Client</th><th>Membership</th><th>Login</th><th>Sign-in methods</th><th>Language</th><th>Joined</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Result.Items)
                    {
                        var methods = string.Join(" · ", new[] { s.HasPassword ? "password" : null, s.HasGoogleLogin ? "Google" : null }.Where(m => m is not null));
                        <tr data-au-href="/Members/Details?id=@s.UserId">
                            <td><a href="/Members/Details?id=@s.UserId">@(s.FullName ?? "(no name)")</a><div class="au-caption">@s.Email</div></td>
                            <td>@if (s.ClientId.HasValue) { <a href="/Clients/Details?id=@s.ClientId">@s.ClientName</a> } else { <span class="au-muted">no client</span> }</td>
                            <td>@Ui.Badge(s.MembershipActive ? "active" : "inactive")</td>
                            <td>@Ui.Badge(s.LoginLocked ? "locked" : "active", s.LoginLocked ? "locked" : "can sign in")</td>
                            <td>@Ui.OrDash(methods)</td>
                            <td>@AppLanguage.ForUser(s.Language)</td>
                            <td>@Ui.Time(s.JoinedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="PagerModel.From(Model.Result)" />
</div>
@if (Model.Invites.Count > 0)
{
    <section class="au-panel au-panel--round au-panel--pad" style="margin-top:24px">
    <div class="au-panel__head"><h3 class="au-panel__title">Invites waiting</h3></div>
    <p class="au-muted" style="font-size:0.8125rem">Sent by the client's account owner. An invite whose link still works holds a seat; cancelling frees it.</p>
    <div class="au-table-card">
        <div class="au-table-scroll">
            <table class="au-table">
                <thead><tr><th>Email</th><th>Name</th><th>Sent</th><th>Link</th><th></th></tr></thead>
                <tbody>
                    @foreach (var invite in Model.Invites)
                    {
                        <tr>
                            <td>@invite.Email</td>
                            <td>@Ui.OrDash(invite.FullName)</td>
                            <td>@Ui.Time(invite.CreatedAt)</td>
                            <td>@if (invite.IsExpired) { @Ui.Badge("inactive", "expired") } else { <span>works until @Ui.Time(invite.ExpiresAt)</span> }</td>
                            <td>
                                <form method="post" asp-page-handler="RevokeInvite" asp-route-clientId="@Model.ClientId">
                                    <input type="hidden" name="inviteId" value="@invite.Id" />
                                    <button class="au-btn au-btn--danger-outlined au-btn--sm" type="submit" data-confirm="Cancel the invite to @invite.Email?">Cancel invite</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </section>
}
