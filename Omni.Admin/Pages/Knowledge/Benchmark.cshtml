@page
@model Omni.Admin.Pages.Knowledge.BenchmarkModel
@{
    ViewData["Title"] = "Search benchmark";
}
<div class="au-page-head">
    <p class="au-page-head__sub">
        How well a clinic's Knowledge Base <strong>search</strong> finds the right piece of information. Each test case is a
        realistic patient question tied to the one chunk that answers it; a run sends the question through the real search (the
        one the clinic's AI uses) and checks where that chunk ranks. It tests retrieval only, not the AI's replies.
    </p>
</div>

@if (Model.ClinicId is null)
{
    <div class="au-table-card">
        <partial name="_EmptyState" model="@(new EmptyStateModel("Choose a clinic with the clinic selector in the header to test its search.", "fact_check"))" />
    </div>
}
else
{
    <div id="bm-root" class="au-stack" data-api="/api/admin/knowledge-benchmark/@Model.ClinicId"
         data-generation-url="/Knowledge/Benchmark/Generations/{id}?clinicId=@Model.ClinicId">
        <div id="bm-message"></div>

        @* ---------- Cases summary + actions ---------- *@
        <section class="au-panel au-panel--round au-panel--pad">
            <div class="au-row au-row--wrap au-row--between">
                <div>
                    <span class="au-eyebrow">@(Model.ClinicName ?? "Selected clinic")</span>
                    <div id="bm-counts" class="au-muted">Loading…</div>
                </div>
                <div class="au-row au-row--wrap">
                    <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bm-generate">Generate test cases</button>
                    <button type="button" class="au-btn au-btn--danger-outlined au-btn--sm" id="bm-stop" hidden title="Stop waiting for the question generator">Stop generating</button>
                    <select id="bm-scope" class="au-select au-select--sm" style="width:auto" aria-label="Which cases to run">
                        <option value="all">All cases</option>
                        <option value="generated">Generated cases</option>
                        <option value="reviewed">Reviewed cases</option>
                    </select>
                    <button type="button" class="au-btn au-btn--primary au-btn--sm" id="bm-run">Run benchmark</button>
                </div>
            </div>
            <div id="bm-generate-note" class="au-help" style="margin-top:8px" hidden></div>
            <div id="bm-progress" class="bm-progress" hidden>
                <div class="au-progress"><div class="au-progress__bar" id="bm-progress-bar"></div></div>
                <div class="au-caption" id="bm-progress-text"></div>
            </div>
        </section>

        @* ---------- Headline metrics of the latest completed run ---------- *@
        <div id="bm-metrics"></div>

        @* ---------- Manual test cases (generated cases live on their own generation's page) ---------- *@
        <section class="au-table-card">
            <div class="au-panel__head">
                <div>
                    <h3 class="au-panel__title">Manual test cases</h3>
                    <div class="au-caption">Cases written by hand, a small trusted set. Generated cases live on their generation's page (Generations below).</div>
                </div>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bm-add-toggle"><span class="au-icon" aria-hidden="true">add</span>Add manual case</button>
            </div>
            <div class="bm-add-form" id="bm-add-form" hidden>
                <div class="au-form-grid">
                    <label class="au-form-field au-span-2">
                        <span class="au-form-label">Patient question</span>
                        <textarea id="bm-add-question" class="au-textarea" rows="2" maxlength="500" placeholder="e.g. How much time should I take off work after a nose job?"></textarea>
                    </label>
                    <label class="au-form-field">
                        <span class="au-form-label">Document that answers it</span>
                        <select id="bm-add-doc" class="au-select"><option value="">Loading…</option></select>
                    </label>
                    <label class="au-form-field">
                        <span class="au-form-label">Chunk that answers it</span>
                        <select id="bm-add-chunk" class="au-select" disabled><option value="">Choose a document first</option></select>
                    </label>
                </div>
                <p class="au-help">A case added by hand is marked reviewed automatically.</p>
                <div class="au-row">
                    <button type="button" class="au-btn au-btn--primary au-btn--sm" id="bm-add-save">Add case</button>
                    <button type="button" class="au-btn au-btn--sm" id="bm-add-cancel">Cancel</button>
                </div>
            </div>
            <div class="au-table-scroll">
                <table class="au-table" data-nosort>
                    <thead><tr><th>Question</th><th>Expected document / chunk</th><th>Reviewed</th><th>Last result</th><th></th></tr></thead>
                    <tbody id="bm-cases-body"><tr class="bm-empty"><td colspan="5">Loading…</td></tr></tbody>
                </table>
            </div>
            <div class="au-row bm-pager" id="bm-cases-pager" hidden>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bm-cases-prev"><span class="au-icon" aria-hidden="true">chevron_left</span>Previous</button>
                <span class="au-caption" id="bm-cases-range"></span>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bm-cases-next">Next<span class="au-icon" aria-hidden="true">chevron_right</span></button>
            </div>
        </section>

        @* ---------- Generations: every "Generate test cases" request and how its cases score ---------- *@
        <section class="au-table-card">
            <div class="au-panel__head">
                <div>
                    <h3 class="au-panel__title">Generations</h3>
                    <div class="au-caption">Each request to the question generator, with what was sent and what came back. Scores are that batch's cases in the latest completed run that included them.</div>
                </div>
            </div>
            <div class="au-table-scroll">
                <table class="au-table" data-nosort>
                    <thead>
                        <tr>
                            <th>Requested</th><th>Status</th><th class="au-right">Chunks sent</th><th class="au-right">Questions</th><th class="au-right">Cases</th>
                            <th class="au-right">Rejected</th><th class="au-right">Chunk top-1</th><th class="au-right">Chunk top-3</th><th class="au-right">Chunk top-5</th>
                            <th class="au-right">Chunk MRR</th><th>Scored in</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="bm-gens-body"><tr class="bm-empty"><td colspan="12">Loading…</td></tr></tbody>
                </table>
            </div>
        </section>

        @* ---------- Run history ---------- *@
        <section class="au-table-card">
            <div class="au-panel__head">
                <div>
                    <h3 class="au-panel__title">Run history</h3>
                    <div class="au-caption">Every run is kept with the settings it used, so runs can be compared after changing chunk size, Top K or minimum similarity.</div>
                </div>
            </div>
            <div class="au-table-scroll">
                <table class="au-table" data-nosort>
                    <thead>
                        <tr>
                            <th>Started</th><th>Cases</th><th>Status</th><th class="au-right">Chunk top-1</th><th class="au-right">Chunk top-3</th>
                            <th class="au-right">Chunk top-5</th><th class="au-right">Chunk MRR</th><th class="au-right">Doc top-3</th><th class="au-right">Latency</th>
                            <th>Settings used</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="bm-runs-body"><tr class="bm-empty"><td colspan="11">Loading…</td></tr></tbody>
                </table>
            </div>
        </section>

        @* ---------- Results of the selected run ---------- *@
        <section class="au-table-card" id="bm-results-section" hidden>
            <div class="au-panel__head">
                <h3 class="au-panel__title" id="bm-results-title">Run results</h3>
                <select id="bm-result-filter" class="au-select au-select--sm" style="width:auto" aria-label="Filter results">
                    <option value="">All results</option>
                    <option value="MISS">Miss</option>
                    <option value="DOCUMENT_ONLY_HIT">Document only</option>
                    <option value="EXACT_CHUNK_HIT">Exact chunk hit</option>
                    <option value="STALE_CASE">Stale</option>
                    <option value="ERROR">Error</option>
                </select>
            </div>
            <div id="bm-run-gens" class="bm-run-gens" hidden>
                <span class="au-eyebrow">Scores by generation (this run)</span>
                <div class="au-table-scroll">
                    <table class="au-table" data-nosort>
                        <thead>
                            <tr>
                                <th>Generation</th><th class="au-right">Scored</th><th class="au-right">Chunk top-1</th><th class="au-right">Chunk top-3</th>
                                <th class="au-right">Chunk top-5</th><th class="au-right">Chunk MRR</th><th class="au-right">Doc top-3</th>
                            </tr>
                        </thead>
                        <tbody id="bm-run-gens-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="au-table-scroll">
                <table class="au-table au-table--clickable" data-nosort>
                    <thead>
                        <tr>
                            <th>Question</th><th>Result</th><th class="au-right">Chunk rank</th><th class="au-right">Document rank</th>
                            <th class="au-right">Expected chunk score</th><th class="au-right">Latency</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="bm-results-body"></tbody>
                </table>
            </div>
        </section>
    </div>

    <partial name="_BenchmarkDialog" />
}

@section Scripts {
    @if (Model.ClinicId is not null)
    {
        <script src="~/js/knowledge-benchmark-kit.js" asp-append-version="true"></script>
        <script src="~/js/knowledge-benchmark.js" asp-append-version="true"></script>
    }
}
