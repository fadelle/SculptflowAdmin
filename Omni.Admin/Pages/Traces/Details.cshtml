@page
@model Omni.Admin.Pages.Traces.DetailsModel
@{
    var tr = Model.Trace;
    ViewData["Title"] = "Message trace";
}
<div class="au-back-header">
    <a class="au-icon-btn au-icon-btn--bordered" href="/Traces" aria-label="Back to message traces"><span class="au-icon" aria-hidden="true">arrow_back</span></a>
    <div style="min-width:0">
        <h2 class="au-back-header__title">Message trace
            @if (tr.HasFailure) { <span class="au-chip au-chip--error au-chip--soft">Something failed</span> } else { <span class="au-chip au-chip--success au-chip--soft">OK</span> }</h2>
        <span class="au-back-header__sub"><span class="au-copy"><span class="au-mono">@tr.TraceId</span></span>
            @if (tr.StartedAt.HasValue) { <text> · @Ui.Time(tr.StartedAt) to @Ui.Time(tr.EndedAt)</text> }</span>
    </div>
    <div class="au-row au-row--wrap">
        @if (tr.ClientId.HasValue) { <a class="au-btn au-btn--outlined" href="/Clients/Details?id=@tr.ClientId">Client</a> }
        @foreach (var c in tr.ConversationIds) { <a class="au-btn au-btn--outlined" href="/Conversations/Details?id=@c">Conversation</a> }
        <a class="au-btn au-btn--outlined" href="/Errors/List?traceId=@tr.TraceId&hours=2160">Errors in this trace</a>
    </div>
</div>

<div class="au-table-card">
    @if (tr.Entries.Count == 0)
    {
        var empty = new EmptyStateModel("Nothing recorded for this trace.", "route");
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <table class="au-table">
            <thead><tr>
                <th>When</th>
                <th></th>
                <th>What happened</th>
                <th class="au-right">Took</th>
                <th>Details</th>
            </tr></thead>
            <tbody>
                @foreach (var e in tr.Entries)
                {
                    <tr>
                        <td style="white-space:nowrap">@Ui.Time(e.At)</td>
                        <td>@Outcome(e.Outcome, e.Kind)</td>
                        <td style="--au-col-max:620px">
                            <div>@e.Summary</div>
                            <div class="au-caption au-mono">@e.Kind · @e.Name</div>
                        </td>
                        <td class="au-right">@(e.DurationMs is { } ms ? ms.ToString("N0") + " ms" : "")</td>
                        <td style="--au-col-max:360px">
                            @if (e.LogId.HasValue) { <a href="/Errors/Details?id=@e.LogId">open error</a> }
                            @if (e.MessageId.HasValue && e.Kind == "message") { <span class="au-caption au-mono" title="@e.MessageId">msg @Ui.Short(e.MessageId.Value)</span> }
                            @if (e.N8nExecutionId is not null) { <span class="au-caption">n8n execution <span class="au-mono">@e.N8nExecutionId</span></span> }
                            @foreach (var (key, value) in e.Detail.Where(d => d.Value is not null && d.Key != "_truncated"))
                            {
                                <div class="au-caption"><span class="au-mono">@key</span>: @Ui.Truncate(value, 160)</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<p class="au-caption">Steps are recorded as the message moves through the app. With the bot in code (Ai / BotEngine = code) every bot step
    (model calls, tools, decision, reply) is in this trace; with n8n, the bot's tool calls and reply join it only when n8n sends the
    <span class="au-mono">traceparent</span> it received back on its calls.</p>

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Outcome(string outcome, string kind) => new Microsoft.AspNetCore.Html.HtmlString(
        outcome switch
        {
            "failed" => "<span class=\"au-chip au-chip--error au-chip--soft\">failed</span>",
            "skipped" => "<span class=\"au-chip au-chip--warning au-chip--soft\">skipped</span>",
            _ => kind == "warning" ? "<span class=\"au-chip au-chip--warning au-chip--soft\">warning</span>" : "<span class=\"au-chip au-chip--success au-chip--soft\">ok</span>"
        });
}