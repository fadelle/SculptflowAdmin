@page
@model Omni.Admin.Pages.Traces.IndexModel
@using Omni.Admin.Common.Statics
@{
    ViewData["Title"] = "Message traces";
    var r = Model.Result;
}
<div class="au-page-head">
    <p class="au-page-head__sub">Each row is one message's story through the app: webhook in, inbox, bot (n8n or code) and its tools, the send to
        WhatsApp or Telegram, and anything that failed on the way. Open one for its timeline, or search by trace id, message id or WhatsApp/Telegram message id.</p>
</div>

<form class="filters au-toolbar" method="get" data-au-autosubmit>
    <div class="au-toolbar__filters">
        <div class="au-field" style="width:170px">
            <label class="au-label" for="f-hours">Period</label>
            <select class="au-select" id="f-hours" name="hours">
                @foreach (var p in MessageTraceOptions.Periods) { <option value="@p.Hours" selected="@(p.Hours == Model.Hours)">@p.Label</option> }
            </select>
        </div>
        <div class="au-field" style="width:300px">
            <label class="au-label" for="f-q">Find a message</label>
            <span class="au-input-icon"><span class="au-icon" aria-hidden="true">search</span><input class="au-input" type="search" id="f-q" name="q" value="@Model.Q" placeholder="trace id, message id or wamid" /></span>
        </div>
        <label class="au-check"><input type="checkbox" name="failed" value="true" checked="@Model.Failed" /> Something failed</label>
    </div>
    <div class="au-toolbar__actions">
        @if (r is not null) { <span class="au-toolbar__meta">@Ui.Count(r.Total, "trace", "traces")</span> }
        <partial name="_FilterActions" />
    </div>
</form>

@if (Model.NotFoundQuery is not null)
{
    <div class="au-alert au-alert--warning" role="status">
        <span class="au-icon au-alert__icon" aria-hidden="true">search_off</span>
        <div class="au-alert__body"><div class="au-alert__title">No trace found</div>Nothing is recorded for "@Model.NotFoundQuery" (it may be older than tracing, or past retention).</div>
    </div>
}
@if (Model.LoadError is not null)
{
    <div class="au-alert au-alert--error" role="alert">
        <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
        <div class="au-alert__body"><div class="au-alert__title">Couldn't load message traces</div>@Model.LoadError</div>
    </div>
}

@if (r is not null)
{
    <div class="au-stack">
        @if (!r.Enabled)
        {
            <div class="au-alert au-alert--warning" role="status">
                <span class="au-icon au-alert__icon" aria-hidden="true">pause_circle</span>
                <div class="au-alert__body"><div class="au-alert__title">Recording is off</div>
                    No new steps are recorded. Turn on MessageTrace → Enabled on the <a asp-page="/Configuration/Index">Configuration</a> page.</div>
            </div>
        }
        <div class="au-table-card">
            @if (r.Items.Count == 0)
            {
                var empty = new EmptyStateModel(Model.Failed ? "Nothing failed in this period." : "No messages traced in this period yet.", "route");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll" style="--au-table-max-h: calc(100vh - 340px)">
                    <table class="au-table">
                        <thead><tr>
                            <th>Last activity</th>
                            <th>Result</th>
                            <th>Started with</th>
                            <th>What failed</th>
                            <th class="au-right">Steps</th>
                            <th>Channel</th>
                            <th>Links</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var t in r.Items)
                            {
                                var failed = t.FailedSteps > 0 || t.Errors > 0;
                                <tr>
                                    <td><a href="/Traces/Details?traceId=@t.TraceId">@Ui.Time(t.EndedAt)</a></td>
                                    <td>@if (failed) { <span class="au-chip au-chip--error au-chip--soft">Failed</span> } else { <span class="au-chip au-chip--success au-chip--soft">OK</span> }</td>
                                    <td class="au-mono">@t.FirstStep</td>
                                    <td style="--au-col-max:380px">@if (t.FailedStep is not null) { <span class="au-mono">@t.FailedStep</span> <span class="au-caption">@Ui.Truncate(t.FailedDetail, 120)</span> }
                                        else if (t.Errors > 0) { <span>@Ui.Count(t.Errors, "error logged", "errors logged")</span> } else { <span class="au-muted">—</span> }</td>
                                    <td class="au-right">@t.Steps</td>
                                    <td>@Ui.OrDash(t.Channel)</td>
                                    <td>
                                        @if (t.ClientId.HasValue) { <a href="/Clients/Details?id=@t.ClientId">client</a> }
                                        @if (t.ConversationId.HasValue) { <a href="/Conversations/Details?id=@t.ConversationId">conversation</a> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="PagerModel.From(Model.Paged)" />
            }
        </div>
        <p class="au-caption">Steps are kept @r.RetentionDays days; traces where something failed are kept @r.FailedRetentionDays days.
            Delivery statuses and charges come from the message itself, so they show for as long as the message exists.</p>
    </div>
}