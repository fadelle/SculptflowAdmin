@page
@model Omni.Admin.Pages.ApiTimings.IndexModel
@using Omni.Admin.Common.Statics
@{
    ViewData["Title"] = "API timings";
    var r = Model.Report;
}
<div class="au-page-head">
    <p class="au-page-head__sub">How long the main app's routes take, from its own per-minute timings (all servers added together).
        Averages and the slowest request are exact; p95 is the request-weighted average of each minute's p95, so read it as a guide.
        Errors are 5xx answers; 4xx (bad input, not found) are counted separately.</p>
</div>

<form class="filters au-toolbar" method="get" data-au-autosubmit>
    <div class="au-toolbar__filters">
        <div class="au-field" style="width:180px">
            <label class="au-label" for="f-hours">Period</label>
            <select class="au-select" id="f-hours" name="hours">
                @foreach (var p in ApiTimingOptions.Periods) { <option value="@p.Hours" selected="@(p.Hours == Model.Hours)">@p.Label</option> }
            </select>
        </div>
        <div class="au-field" style="width:220px">
            <label class="au-label" for="f-sort">Sort by</label>
            <select class="au-select" id="f-sort" name="sort">
                @foreach (var s in ApiTimingOptions.Sorts) { <option value="@s.Key" selected="@(s.Key == Model.Sort)">@s.Label</option> }
            </select>
        </div>
        <div class="au-field" style="width:110px">
            <label class="au-label" for="f-take">Show</label>
            <select class="au-select" id="f-take" name="take">
                @foreach (var t in ApiTimingOptions.Takes) { <option value="@t" selected="@(t == Model.Take)">@t</option> }
            </select>
        </div>
    </div>
    <div class="au-toolbar__actions">
        @if (r is not null) { <span class="au-toolbar__meta">@Ui.Count(r.RouteCount, "route", "routes")</span> }
        <partial name="_FilterActions" />
    </div>
</form>

@if (r is not null)
{
    <div class="au-stack">
        @if (!r.Enabled)
        {
            <div class="au-alert au-alert--warning" role="status">
                <span class="au-icon au-alert__icon" aria-hidden="true">pause_circle</span>
                <div class="au-alert__body"><div class="au-alert__title">Recording is off</div>
                    Nothing new is being recorded. Turn on Monitoring → Enabled on the <a asp-page="/Configuration/Index">Configuration</a> page.</div>
            </div>
        }

        <div class="au-grid au-grid--4" style="--au-gap:12px">
            <div class="au-stat"><span class="au-eyebrow">Requests</span><div class="au-stat__value">@r.TotalRequests.ToString("N0")</div></div>
            <div class="au-stat"><span class="au-eyebrow">Errors (5xx)</span><div class="au-stat__value">@r.TotalErrors.ToString("N0")
                <span class="au-stat__hint">@Percent(r.TotalErrors, r.TotalRequests)</span></div></div>
            <div class="au-stat"><span class="au-eyebrow">Slow (≥ @r.SlowRequestMs.ToString("N0") ms)</span><div class="au-stat__value">@r.TotalSlowRequests.ToString("N0")
                <span class="au-stat__hint">@Percent(r.TotalSlowRequests, r.TotalRequests)</span></div></div>
            <div class="au-stat"><span class="au-eyebrow">Routes seen</span><div class="au-stat__value">@r.RouteCount.ToString("N0")
                <span class="au-stat__hint">kept @r.RetentionDays days</span></div></div>
        </div>

        <div class="au-table-card">
            @if (r.Routes.Count == 0)
            {
                var empty = new EmptyStateModel(r.Enabled ? "No requests recorded in this period yet. Rows appear a minute after traffic." : "No requests recorded in this period.", "speed");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll" style="--au-table-max-h: calc(100vh - 360px)">
                    <table class="au-table">
                        <thead><tr>
                            <th>Route</th>
                            <th class="au-right">Calls</th>
                            <th class="au-right">Avg ms</th>
                            <th class="au-right">p95 ms</th>
                            <th class="au-right">Max ms</th>
                            <th class="au-right">5xx</th>
                            <th class="au-right">4xx</th>
                            <th class="au-right">Slow</th>
                            <th class="au-right">Total time</th>
                            <th>Last seen</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var row in r.Routes)
                            {
                                <tr>
                                    <td style="--au-col-max:460px" title="@row.Method @row.Route"><span class="au-chip au-chip--outlined">@row.Method</span> <span class="au-mono">@row.Route</span></td>
                                    <td class="au-right">@row.Requests.ToString("N0")</td>
                                    <td class="au-right">@if (row.AvgMs >= r.SlowRequestMs) { <span class="au-chip au-chip--warning">@row.AvgMs.ToString("N1")</span> } else { @row.AvgMs.ToString("N1") }</td>
                                    <td class="au-right">@row.P95Ms.ToString("N1")</td>
                                    <td class="au-right">@if (row.MaxMs >= r.SlowRequestMs) { <span class="au-chip au-chip--warning">@row.MaxMs.ToString("N0")</span> } else { @row.MaxMs.ToString("N0") }</td>
                                    <td class="au-right">@if (row.Errors > 0) { <span class="au-chip au-chip--error">@row.Errors.ToString("N0")</span> } else { <span class="au-muted">0</span> }</td>
                                    <td class="au-right">@row.ClientErrors.ToString("N0")</td>
                                    <td class="au-right">@row.SlowRequests.ToString("N0")</td>
                                    <td class="au-right">@Duration(row.TotalSeconds)</td>
                                    <td>@Ui.Time(row.LastSeenAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <p class="au-caption">@r.From.ToString("MMM d, HH:mm") – @r.To.ToString("MMM d, HH:mm") UTC. Requests slower than @r.SlowRequestMs.ToString("N0") ms are also written to the main app's log as "Slow request".</p>
    </div>
}

@functions {
    private static string Percent(long part, long total) => total == 0 ? "—" : (100.0 * part / total).ToString("N1") + "%";

    private static string Duration(double seconds) => seconds switch
    {
        < 60 => seconds.ToString("N1") + " s",
        < 3600 => (seconds / 60).ToString("N1") + " min",
        _ => (seconds / 3600).ToString("N1") + " h"
    };
}
