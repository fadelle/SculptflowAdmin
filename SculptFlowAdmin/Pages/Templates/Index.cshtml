@page
@model SculptFlowAdmin.Pages.Templates.IndexModel
@{ ViewData["Title"] = "WhatsApp templates"; }
<div class="page-head"><div><h1>WhatsApp templates</h1><div class="muted">Read-only. Templates are created and approved through the WhatsApp provider; clinics manage them in the main app.</div></div></div>
<form class="filters" method="get">
    <partial name="_ClinicFilter" model="(Model.Clinics, Model.ClinicId)" />
    <label>Status
        <select name="status"><option value="">All</option>
            @foreach (var s in WhatsAppTemplateStatus.All) { <option value="@s" selected="@(s == Model.Status)">@s</option> }
        </select>
    </label>
    <button class="btn" type="submit">Filter</button>
</form>
@if (Model.Rows.Count == 0)
{
    <div class="card empty">No templates.</div>
}
else
{
<div class="table-wrap">
<table>
    <tr><th>Template</th><th>Clinic</th><th>Provider</th><th>Category</th><th>Language</th><th>Status</th><th>Quality</th><th>Body</th><th>Updated</th></tr>
    @foreach (var t in Model.Rows)
    {
        <tr>
            <td class="mono">@t.Name</td>
            <td><a href="/Clinics/Details?id=@t.ClinicId">@t.ClinicName</a></td>
            <td>@Ui.Badge(t.Provider)</td>
            <td>@t.Category</td>
            <td>@t.Language</td>
            <td>@Ui.Badge(t.Status) @if (t.RejectionReason is not null) { <div class="small" style="color:var(--red-text)">@t.RejectionReason</div> }</td>
            <td>@t.QualityRating</td>
            <td class="small">@Ui.Truncate(t.Body, 160)</td>
            <td class="small">@Ui.Time(t.UpdatedAt)</td>
        </tr>
    }
</table>
</div>
}
