@page
@model SculptFlowAdmin.Pages.Templates.IndexModel
@{ ViewData["Title"] = "WhatsApp templates"; }
<div class="au-page-head"><p class="au-page-head__sub">Read-only. Templates are created and approved through the WhatsApp provider; clinics manage them in the main app.</p></div>
<form class="filters au-toolbar" method="get">
    <div class="au-toolbar__filters">
        <div class="au-field" style="width:240px">
            <label class="au-label" for="f-find">Find on this page</label>
            <span class="au-input-icon"><span class="au-icon" aria-hidden="true">filter_list</span><input class="au-input" type="search" id="f-find" data-filter="#rows" placeholder="Name, body or clinic" /></span>
        </div>
        <div class="au-field" style="width:160px">
            <label class="au-label" for="f-status">Status</label>
            <select class="au-select" id="f-status" name="status"><option value="">All</option>
                @foreach (var s in WhatsAppTemplateStatus.All) { <option value="@s" selected="@(s == Model.Status)">@s</option> }
            </select>
        </div>
    </div>
    <div class="au-toolbar__actions">
        <span class="au-toolbar__meta">@Ui.Count(Model.Rows.Count, "template", "templates")</span>
        <partial name="_FilterActions" />
    </div>
</form>
<div class="au-table-card">
    @if (Model.Rows.Count == 0)
    {
        var empty = new EmptyStateModel(Request.EmptyMessage("templates"), "article");
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="au-table-scroll">
            <table class="au-table" id="rows">
                <thead>
                    <tr><th>Template</th><th>Clinic</th><th>Provider</th><th>Category</th><th>Language</th><th>Status</th><th>Quality</th><th>Body</th><th>Updated</th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Rows)
                    {
                        <tr>
                            <td><span class="au-mono">@t.Name</span></td>
                            <td><a href="/Clinics/Details?id=@t.ClinicId">@t.ClinicName</a></td>
                            <td>@Ui.Badge(t.Provider)</td>
                            <td>@Ui.OrDash(t.Category)</td>
                            <td>@Ui.OrDash(t.Language)</td>
                            <td>@Ui.Badge(t.Status) @if (t.RejectionReason is not null) { <div class="au-caption au-text-error">@t.RejectionReason</div> }</td>
                            <td>@Ui.OrDash(t.QualityRating)</td>
                            <td style="--au-col-max:340px" title="@t.Body">@Ui.Truncate(t.Body, 160)</td>
                            <td>@Ui.Time(t.UpdatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
