@page
@model SculptFlowAdmin.Pages.Leads.DetailsModel
@{
    var l = Model.Lead;
    var name = l.FullName ?? $"{l.FirstName} {l.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(name)) name = "(no name)";
    ViewData["Title"] = name;
}
<div class="page-head">
    <div>
        <h1>@name @Ui.Badge(l.Status)</h1>
        <div class="muted small"><a href="/Clinics/Details?id=@l.ClinicId">@l.Clinic?.Name</a> · <span class="mono">@l.Id</span> · created @Ui.Time(l.CreatedAt)</div>
    </div>
</div>

<div class="grid grid-2">
    <div class="card">
        <h2>Lead</h2>
        <dl class="kv">
            <dt>Phone</dt><dd>@l.Phone</dd>
            <dt>Email</dt><dd>@l.Email</dd>
            <dt>Procedure of interest</dt><dd>@l.Procedure?.Name</dd>
            <dt>Source</dt><dd>@l.Source @l.SourceDetail</dd>
            <dt>Ad campaign</dt><dd>@l.CampaignName</dd>
            <dt>External lead id</dt><dd class="mono">@l.ExternalLeadId</dd>
            <dt>Language / country / city</dt><dd>@l.PreferredLanguage @l.CountryCode @l.City</dd>
            <dt>Timeline</dt><dd>@l.DesiredTimeline</dd>
            <dt>Last contact</dt><dd>@Ui.Time(l.LastContactAt)</dd>
            <dt>Next follow-up</dt><dd>@Ui.Time(l.NextFollowupAt)</dd>
            <dt>Opted out at</dt><dd>@Ui.Time(l.OptedOutAt)</dd>
        </dl>
    </div>

    <form class="card" method="post" asp-page-handler="Update" asp-route-id="@l.Id">
        <h2>Edit</h2>
        <div class="form-row"><label>Status</label>
            <select name="status">@foreach (var s in LeadStatus.All.OrderBy(x => x)) { <option value="@s" selected="@(s == l.Status)">@s.Replace('_', ' ')</option> }</select></div>
        <div class="form-row"><label>Qualification</label>
            <select name="qualificationStatus">@foreach (var s in LeadQualificationStatus.All.OrderBy(x => x)) { <option value="@s" selected="@(s == l.QualificationStatus)">@s.Replace('_', ' ')</option> }</select></div>
        <div class="form-row"><label>Marketing</label>
            <select name="marketingOptIn">
                <option value="true" selected="@l.MarketingOptIn">Opted in (campaigns can reach them)</option>
                <option value="false" selected="@(!l.MarketingOptIn)">Opted out</option>
            </select></div>
        <div class="form-row"><label>Notes</label><textarea name="notes">@l.Notes</textarea></div>
        <button class="btn primary" type="submit">Save lead</button>
    </form>
</div>

<div class="card">
    <h2>Conversations</h2>
    <partial name="_ConversationTable" model="Model.Conversations" />
</div>

<div class="card">
    <h2>Appointments</h2>
    <partial name="_AppointmentTable" model="Model.Appointments" />
</div>

<div class="card">
    <h2>Events (latest 100)</h2>
    <partial name="_EventTable" model="Model.Events.Select(e => new EventRow(e.Id, e.ClinicId, l.Clinic?.Name ?? string.Empty, e.EventType, e.Source, e.LeadId, e.ConversationId, e.AppointmentId, e.Metadata, e.CreatedAt)).ToList()" />
</div>
