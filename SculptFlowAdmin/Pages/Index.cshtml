@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var t = Model.Totals;
    var max = Math.Max(1, Model.Daily.Max(d => d.Inbound + d.Ai + d.Staff));
    // Status board levels: the same conditions the old tiles flagged as "warn".
    var channelProblems = t.UnhealthyChannels + t.CalendarProblems;
    var channelLevel = channelProblems > 0 ? "crit" : t.ConnectedChannels > 0 ? "ok" : "idle";
    var deliveryLevel = t.FailedMessagesLast7Days > 0 ? "warn" : "ok";
    var problemsLevel = Model.Problems.Count > 0 ? "crit" : "ok";
    // Handoffs to staff are normal work, not a health signal (the old tile never flagged them): neutral, not in the verdict.
    var levels = new[] { channelLevel, deliveryLevel, problemsLevel };
    var (verdict, verdictTone) = levels.Contains("crit") ? ("Attention required", "au-chip--error")
        : levels.Contains("warn") ? ("Minor issues", "au-chip--warning") : ("All systems healthy", "au-chip--success");
}
<div class="au-stack" style="--au-gap:24px">
    <section class="au-hero">
        <span class="au-hero__mark"><partial name="_BrandMark" model="56" /></span>
        <div style="min-width:0">
            <h2 class="au-hero__title">SculptFlow Admin</h2>
            <p class="au-hero__sub">Everything across all clinics.</p>
        </div>
    </section>

    <section>
        <div class="au-status-board__head">
            <h3 class="au-h3" style="margin:0">System status</h3>
            <span class="au-chip au-chip--soft @verdictTone">@verdict</span>
        </div>
        <div class="au-status-grid">
            <a class="au-status" data-level="@channelLevel" href="@(channelProblems > 0 ? "/Channels?problems=true" : "/Channels")">
                <div class="au-status__head"><span class="au-icon" aria-hidden="true">hub</span><span class="au-eyebrow">Channels &amp; calendars</span><span class="au-dot" aria-hidden="true"></span></div>
                <div class="au-status__metric">@(channelProblems > 0 ? Ui.Count(channelProblems, "problem", "problems") : "Healthy")</div>
                <span class="au-status__sub">@t.ConnectedChannels connected channels</span>
            </a>
            <a class="au-status" data-level="@deliveryLevel" href="/Messages?failed=true">
                <div class="au-status__head"><span class="au-icon" aria-hidden="true">send</span><span class="au-eyebrow">Message delivery</span><span class="au-dot" aria-hidden="true"></span></div>
                <div class="au-status__metric">@Ui.Count(t.FailedMessagesLast7Days, "failed send", "failed sends")</div>
                <span class="au-status__sub">in the last 7 days</span>
            </a>
            <a class="au-status" data-level="@problemsLevel" href="#attention">
                <div class="au-status__head"><span class="au-icon" aria-hidden="true">report</span><span class="au-eyebrow">Needs attention</span><span class="au-dot" aria-hidden="true"></span></div>
                <div class="au-status__metric">@(Model.Problems.Count == 0 ? "Nothing broken" : Ui.Count(Model.Problems.Count, "open problem", "open problems"))</div>
                <span class="au-status__sub">listed below</span>
            </a>
            <a class="au-status" data-level="idle" href="/Conversations?mode=human&status=active">
                <div class="au-status__head"><span class="au-icon" aria-hidden="true">support_agent</span><span class="au-eyebrow">Open conversations with staff</span><span class="au-dot" aria-hidden="true"></span></div>
                <div class="au-status__metric">@t.ConversationsInHumanMode <span class="au-caption">/ @t.Conversations</span></div>
                <span class="au-status__sub">handed from the AI to clinic staff</span>
            </a>
        </div>
    </section>

    <div class="au-grid au-grid--4" style="--au-gap:12px">
        <a class="au-stat" href="/Clinics"><span class="au-eyebrow">Clinics (active / all)</span><div class="au-stat__value">@t.ActiveClinics <span class="au-stat__hint">/ @t.Clinics</span></div></a>
        <a class="au-stat" href="/Staff"><span class="au-eyebrow">Active staff accounts</span><div class="au-stat__value">@t.StaffUsers</div></a>
        <a class="au-stat" href="/Leads"><span class="au-eyebrow">Leads (new in 7 days)</span><div class="au-stat__value">@t.Leads.ToString("N0") <span class="au-stat__hint">+@t.LeadsLast7Days</span></div></a>
        <a class="au-stat" href="/Messages"><span class="au-eyebrow">Messages 24h / 7d</span><div class="au-stat__value">@t.MessagesLast24h <span class="au-stat__hint">/ @t.MessagesLast7Days</span></div></a>
        <div class="au-stat"><span class="au-eyebrow">AI replies / inbound (7d)</span><div class="au-stat__value">@t.AiMessagesLast7Days <span class="au-stat__hint">/ @t.InboundLast7Days</span></div></div>
        <a class="au-stat" href="/Appointments?upcoming=true"><span class="au-eyebrow">Upcoming appointments</span><div class="au-stat__value">@t.UpcomingAppointments <span class="au-stat__hint">+@t.AppointmentsBookedLast7Days booked 7d</span></div></a>
        <a class="au-stat" href="/Campaigns?status=running"><span class="au-eyebrow">Running campaigns</span><div class="au-stat__value">@t.RunningCampaigns</div></a>
        <a class="au-stat" href="/Knowledge"><span class="au-eyebrow">Knowledge documents</span><div class="au-stat__value">@t.KnowledgeDocuments</div></a>
    </div>

    <div class="au-grid au-grid--2" style="align-items:start">
        <section class="au-panel au-panel--round au-panel--pad">
            <div class="au-panel__head"><h3 class="au-panel__title">Messages per day (last 14 days, UTC)</h3><a class="au-panel__link" href="/Messages">View messages →</a></div>
            <div class="bars">
                @foreach (var d in Model.Daily)
                {
                    var total = d.Inbound + d.Ai + d.Staff;
                    <div class="col" title="@d.Day: @d.Inbound inbound, @d.Ai AI, @d.Staff staff, @d.Failed failed">
                        <div class="bar ai" style="height:@(d.Ai * 100 / max)%"></div>
                        <div class="bar" style="height:@((total - d.Ai) * 100 / max)%"></div>
                        <div class="lbl">@d.Day.ToString("dd")</div>
                    </div>
                }
            </div>
            <div class="legend"><span><i class="ai"></i>AI replies</span><span><i></i>Customers + staff</span></div>
        </section>

        <section class="au-table-card" id="attention">
            <div class="au-panel__head"><h3 class="au-panel__title">Needs attention (@Model.Problems.Count)</h3></div>
            @if (Model.Problems.Count == 0)
            {
                var allGood = new EmptyStateModel("Nothing broken right now.", "check_circle");
                <partial name="_EmptyState" model="allGood" />
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table">
                        <thead><tr><th>What</th><th>Clinic</th><th>Detail</th><th>When</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Problems.Take(15))
                            {
                                <tr>
                                    <td>@Ui.Badge("error", p.Kind) <a href="@p.Link">@p.Title</a></td>
                                    <td><a href="/Clinics/Details?id=@p.ClinicId">@p.ClinicName</a></td>
                                    <td title="@p.Detail">@Ui.Truncate(p.Detail, 120)</td>
                                    <td>@Ui.Time(p.At)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <section class="au-table-card">
        <div class="au-panel__head"><h3 class="au-panel__title">Newest clinics</h3><a class="au-panel__link" href="/Clinics">All clinics →</a></div>
        <partial name="_ClinicTable" model="Model.RecentClinics" />
    </section>
</div>
