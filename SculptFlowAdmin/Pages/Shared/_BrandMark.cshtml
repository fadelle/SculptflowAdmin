@model int
@* The brand mark: the SculptFlow "S" (from logo.svg) stroked in the Aurora gradient on a dark tile. The only other place
   raw colours are allowed (docs/UI_GUIDE.md §6). Model = size in px. *@
@{ var gid = "au-mark-" + Guid.NewGuid().ToString("N")[..8]; }
<svg width="@Model" height="@Model" viewBox="0 0 32 32" role="img" aria-label="SculptFlow Admin">
    <defs>
        <linearGradient id="@(gid)" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#6366f1" /><stop offset=".55" stop-color="#8b5cf6" /><stop offset="1" stop-color="#a855f7" />
        </linearGradient>
    </defs>
    <rect x="1" y="1" width="30" height="30" rx="8" fill="#0d1117" stroke="url(#@(gid))" stroke-width="2" />
    <path d="M21.5 9.75C20.25 7.6 16.6 6.8 14.1 8.2C11.5 9.65 11.8 12.7 14.7 14.2C17.8 15.8 20.7 16.7 20.3 20C19.9 23.2 15.7 24.7 12.6 23C11 22.1 10.2 20.6 10.1 19.2"
          fill="none" stroke="url(#@(gid))" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M9.75 25.25C14 26.75 20.5 26.8 24.75 24.7" fill="none" stroke="url(#@(gid))" stroke-opacity=".75" stroke-width="1.6" stroke-linecap="round" />
</svg>
