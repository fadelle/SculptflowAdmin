@model (List<ClinicOption> Clinics, Guid? Selected)
<label>Clinic
    <select name="clinicId">
        <option value="">All clinics</option>
        @foreach (var c in Model.Clinics)
        {
            <option value="@c.Id" selected="@(c.Id == Model.Selected)">@c.Name</option>
        }
    </select>
</label>
