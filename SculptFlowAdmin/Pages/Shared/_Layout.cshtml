@using SculptFlowAdmin.Pages.Shared
@* The Aurora shell (docs/UI_GUIDE.md §3.2, §5): dark sidebar, glass header + section tabs, command palette, toasts. *@
@{
    var pageTitle = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" data-au-app="admin">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "SculptFlow Admin" : $"{pageTitle} · SculptFlow Admin")</title>
    @* Stamps theme + rail state before first paint (no white flash in dark mode). Falls back once to the pre-Aurora keys
       (sf-theme, sf-sidebar) so a saved choice survives the redesign. *@
    <script>
        (function () {
            try {
                var ls = localStorage, r = document.documentElement;
                var saved = ls.getItem('admin.themeMode') || ls.getItem('sf-theme');
                var mode = saved === 'light' || saved === 'dark' ? saved
                    : (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                r.setAttribute('data-theme', mode);
                r.style.backgroundColor = mode === 'dark' ? '#070b15' : '#f2f5fa';
                var rail = ls.getItem('admin.sidebarCollapsed');
                if (rail === '1' || (rail === null && ls.getItem('sf-sidebar') === 'collapsed')) r.classList.add('au-side-collapsed');
            } catch (e) { }
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/logo.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400..800&family=JetBrains+Mono:wght@@400..700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..24,400,0..1,0&display=block" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/aurora.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="au-app">
        <partial name="_Sidebar" />
        <div class="au-scrim"></div>
        <div class="au-main-col">
            <header class="au-header">
                <partial name="_Header" />
                <partial name="_SectionTabs" />
                <div class="au-topbar-progress" aria-hidden="true"><div class="au-topbar-progress__bar"></div></div>
            </header>
            <main class="au-main" id="main">
                @if (Model is AdminPageModel flashPage && !string.IsNullOrEmpty(flashPage.FlashError))
                {
                    @* A failed write (RunAsync → PRG). Stays until dismissed or the next page, like the old error toast. *@
                    <div class="au-alert au-alert--error" role="alert">
                        <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
                        <div class="au-alert__body"><div class="au-alert__title">That didn't go through</div>@flashPage.FlashError</div>
                        <div class="au-alert__actions">
                            <button type="button" class="au-icon-btn au-icon-btn--sm" data-dismiss-alert aria-label="Dismiss">
                                <span class="au-icon" aria-hidden="true">close</span>
                            </button>
                        </div>
                    </div>
                }
                @if (Model is MainAppPageModel loadPage && !string.IsNullOrEmpty(loadPage.LoadError))
                {
                    var loadErrorPanel = ErrorPanelModel.From("Couldn't load this from the main app", loadPage.LoadError, Context);
                    <partial name="_ErrorPanel" model="loadErrorPanel" />
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_CommandPalette" />
    <partial name="_Toasts" />

    @* site.js's data-confirm popup (ids read by site.js). *@
    <dialog class="au-dialog" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-text">
        <form method="dialog">
            <h2 class="au-dialog__title" id="confirm-title">Please confirm</h2>
            <div class="au-dialog__content"><p class="au-dialog__text" id="confirm-text"></p></div>
            <div class="au-dialog__actions">
                <button class="au-btn" value="cancel">Cancel</button>
                <button class="au-btn au-btn--primary" value="ok" id="confirm-ok">Confirm</button>
            </div>
        </form>
    </dialog>

    <script src="~/js/aurora.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
