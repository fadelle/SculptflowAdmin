@{
    var path = Context.Request.Path.Value ?? "/";
    bool Starts(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    bool IsActive(string prefix) => prefix == "/" ? path == "/" : Starts(prefix);
    var userName = AdminClaims.Name(User) ?? "Admin";
    var userInitial = userName.Trim().Length > 0 ? userName.Trim()[0].ToString().ToUpperInvariant() : "A";

    // Icon paths (24x24, stroke) for the sidebar links.
    var icons = new Dictionary<string, string>
    {
        ["dashboard"] = "<rect x='3' y='3' width='7' height='9' rx='1.5'/><rect x='14' y='3' width='7' height='5' rx='1.5'/><rect x='14' y='12' width='7' height='9' rx='1.5'/><rect x='3' y='16' width='7' height='5' rx='1.5'/>",
        ["clinics"] = "<path d='M3 21h18'/><path d='M5 21V7l7-4 7 4v14'/><path d='M9 21v-6h6v6'/><path d='M12 8v4M10 10h4'/>",
        ["staff"] = "<path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M22 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>",
        ["leads"] = "<circle cx='12' cy='8' r='4'/><path d='M4 21v-1a7 7 0 0 1 14 0v1'/>",
        ["conversations"] = "<path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/>",
        ["messages"] = "<path d='m22 2-7 20-4-9-9-4z'/><path d='M22 2 11 13'/>",
        ["appointments"] = "<rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/>",
        ["billing"] = "<rect x='2' y='5' width='20' height='14' rx='2'/><path d='M2 10h20'/>",
        ["plans"] = "<path d='m12 2 9 5-9 5-9-5z'/><path d='m3 12 9 5 9-5'/><path d='m3 17 9 5 9-5'/>",
        ["rates"] = "<path d='M12 2v20'/><path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/>",
        ["report"] = "<path d='M3 3v18h18'/><path d='m7 15 4-4 3 3 5-6'/>",
        ["channels"] = "<path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/>",
        ["templates"] = "<path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><path d='M14 2v6h6M8 13h8M8 17h5'/>",
        ["campaigns"] = "<path d='m3 11 18-5v12L3 14v-3z'/><path d='M11.6 16.8a3 3 0 1 1-5.8-1.6'/>",
        ["procedures"] = "<path d='M9 2h6v4H9z'/><path d='M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'/><path d='M9 12h6M9 16h4'/>",
        ["knowledge"] = "<path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z'/><path d='M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5'/>",
        ["config"] = "<path d='M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6'/>",
        ["cache"] = "<ellipse cx='12' cy='5' rx='9' ry='3'/><path d='M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5'/><path d='M3 12c0 1.66 4 3 9 3s9-1.34 9-3'/>",
        ["events"] = "<path d='M22 12h-4l-3 9L9 3l-3 9H2'/>",
        ["audit"] = "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/><path d='m9 12 2 2 4-4'/>",
        ["admins"] = "<circle cx='12' cy='8' r='4'/><path d='M6 21v-1a6 6 0 0 1 12 0v1'/><path d='m19 3 2 2-2 2'/>",
    };

    var groups = new (string Label, (string Href, string Text, string Icon, bool Active)[] Links)[]
    {
        ("", new[] { ("/", "Dashboard", "dashboard", IsActive("/")) }),
        ("Tenants", new[]
        {
            ("/Clinics", "Clinics", "clinics", IsActive("/Clinics")),
            ("/Staff", "Staff accounts", "staff", IsActive("/Staff")),
        }),
        ("Patients", new[]
        {
            ("/Leads", "Leads", "leads", IsActive("/Leads")),
            ("/Conversations", "Conversations", "conversations", IsActive("/Conversations")),
            ("/Messages", "Messages", "messages", IsActive("/Messages")),
            ("/Appointments", "Appointments", "appointments", IsActive("/Appointments")),
        }),
        ("Billing", new[]
        {
            ("/Billing", "Billing accounts", "billing", path.Equals("/Billing", StringComparison.OrdinalIgnoreCase) || path.Equals("/Billing/Index", StringComparison.OrdinalIgnoreCase) || Starts("/Billing/Clinic")),
            ("/Billing/Plans", "Plans", "plans", Starts("/Billing/Plans")),
            ("/Billing/RateCards", "Rate cards", "rates", Starts("/Billing/RateCards") || Starts("/Billing/Rates")),
            ("/Billing/Report", "Revenue report", "report", Starts("/Billing/Report")),
        }),
        ("Setup", new[]
        {
            ("/Channels", "Channels & integrations", "channels", IsActive("/Channels")),
            ("/Templates", "WhatsApp templates", "templates", IsActive("/Templates")),
            ("/Campaigns", "Campaigns", "campaigns", IsActive("/Campaigns")),
            ("/Procedures", "Procedures", "procedures", IsActive("/Procedures")),
            ("/Knowledge", "Knowledge base", "knowledge", IsActive("/Knowledge")),
        }),
        ("System", new[]
        {
            ("/Configuration", "Configuration", "config", IsActive("/Configuration")),
            ("/Cache", "Cache", "cache", IsActive("/Cache")),
            ("/Events", "Event log", "events", IsActive("/Events")),
            ("/Audit", "Admin audit log", "audit", IsActive("/Audit")),
            ("/Admins", "Admin users", "admins", IsActive("/Admins")),
        }),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · SculptFlow Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/logo.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Applies the saved theme and sidebar state before first paint, so nothing flashes. *@
    <script>try { var t = localStorage.getItem('sf-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); if (localStorage.getItem('sf-sidebar') === 'collapsed') document.documentElement.setAttribute('data-sidebar', 'collapsed'); } catch (e) { }</script>
</head>
<body>
<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-top">
            <a class="sidebar-brand" href="/" title="SculptFlow Admin">
                <img src="~/logo.svg" alt="" width="28" height="28" />
                <span>SculptFlow <span class="sidebar-tag">Admin</span></span>
            </a>
            <button type="button" class="sidebar-collapse" id="sidebar-collapse" title="Collapse sidebar" aria-label="Collapse sidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
            </button>
        </div>

        <nav class="sidebar-nav">
            @foreach (var g in groups)
            {
                if (g.Label != "") { <div class="sidebar-label">@g.Label</div> }
                foreach (var l in g.Links)
                {
                    <a href="@l.Href" class="@(l.Active ? "active" : "")" title="@l.Text" aria-current="@(l.Active ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(icons[l.Icon])</svg>
                        <span>@l.Text</span>
                    </a>
                }
            }
        </nav>

        <div class="sidebar-user">
            <button type="button" class="sidebar-user-btn" id="user-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" title="@userName">
                <span class="avatar" aria-hidden="true">@userInitial</span>
                <span class="sidebar-user-name">@userName</span>
                <svg class="sidebar-user-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5-5 5 5"/></svg>
            </button>
            <div class="user-menu" id="user-menu" role="menu" hidden>
                <button type="button" class="user-menu-item" id="theme-toggle" role="menuitem">
                    <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    <span id="theme-toggle-label">Dark mode</span>
                </button>
                <form method="post" action="/Logout">
                    <button class="user-menu-item" type="submit" role="menuitem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <div class="main">
        <header class="mobilebar">
            <button type="button" class="icon-btn" id="sidebar-toggle" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <span class="mobilebar-title">@ViewData["Title"]</span>
        </header>
        <main class="content">
            @if (Model is SculptFlowAdmin.Pages.Shared.MainAppPageModel b && !string.IsNullOrEmpty(b.LoadError))
            {
                <div class="alert err">@b.LoadError</div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<div class="toasts" aria-live="polite">
    @if (Model is SculptFlowAdmin.Pages.Shared.AdminPageModel m)
    {
        if (!string.IsNullOrEmpty(m.Flash)) { <div class="toast ok" data-autohide><span>@m.Flash</span><button type="button" class="toast-x" aria-label="Dismiss">×</button></div> }
        if (!string.IsNullOrEmpty(m.FlashError)) { <div class="toast err" role="alert"><span>@m.FlashError</span><button type="button" class="toast-x" aria-label="Dismiss">×</button></div> }
    }
</div>

<dialog class="modal modal-sm" id="confirm-dialog">
    <form method="dialog">
        <div class="modal-body"><p id="confirm-text"></p></div>
        <div class="modal-foot">
            <button class="btn" value="cancel">Cancel</button>
            <button class="btn primary" value="ok" id="confirm-ok">Confirm</button>
        </div>
    </form>
</dialog>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
