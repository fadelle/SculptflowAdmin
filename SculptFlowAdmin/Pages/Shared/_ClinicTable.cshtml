@model IReadOnlyList<ClinicRow>
@if (Model.Count == 0)
{
    <div class="empty">No clinics.</div>
}
else
{
<div class="table-wrap">
<table>
    <tr><th>Clinic</th><th>Status</th><th>WhatsApp</th><th class="num">Staff</th><th class="num">Leads</th><th class="num">Conversations</th><th>Last message</th><th>Signed up</th></tr>
    @foreach (var c in Model)
    {
        <tr>
            <td><a href="/Clinics/Details?id=@c.Id">@c.Name</a><div class="small muted">@c.Slug @(c.Email is null ? "" : "· " + c.Email)</div></td>
            <td>@Ui.Badge(c.IsActive ? "active" : "inactive")</td>
            <td>@Ui.Badge(c.WhatsAppStatus)</td>
            <td class="num">@c.StaffCount</td>
            <td class="num">@c.LeadCount</td>
            <td class="num">@c.ConversationCount</td>
            <td class="small">@Ui.Time(c.LastMessageAt)</td>
            <td class="small">@Ui.Time(c.CreatedAt)</td>
        </tr>
    }
</table>
</div>
}
