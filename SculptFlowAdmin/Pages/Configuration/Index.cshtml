@page
@model SculptFlowAdmin.Pages.Configuration.IndexModel
@{
    ViewData["Title"] = "Configuration";
}
<div class="page-head">
    <div><h1>Configuration</h1>
        <div class="muted">The main app's settings, by section and key. A value saved here applies to every clinic, and the main app uses it at once.
            Without one, the built-in default applies. Secrets are never managed here; they stay in the server's environment.</div></div>
</div>

@if (Model.LoadError is null)
{
    <form class="filters" method="get">
        <label class="search">Setting<input type="search" name="q" value="@Model.Q" placeholder="e.g. Availability" /></label>
        <label class="check"><input type="checkbox" name="changed" value="true" checked="@Model.ChangedOnly" /> Changed from default only</label>
        <partial name="_FilterActions" />
    </form>

    @if (Model.Sections.Count == 0)
    {
        <div class="card empty">No settings match.</div>
    }
    @foreach (var group in Model.Sections)
    {
        <h2 style="margin-top:22px">@group.Key</h2>
        <div class="table-wrap">
            <table>
                <tr><th>Key</th><th>Default</th><th>Saved value</th><th>In use now</th><th></th></tr>
                @foreach (var s in group)
                {
                    var range = s.Min is null && s.Max is null ? "" : $" ({s.Min?.ToString("0.##")}–{s.Max?.ToString("0.##")})";
                    <tr>
                        <td><span class="mono small">@s.Key</span>
                            <div class="small muted">@s.Description <span class="nowrap">@s.Type.ToLowerInvariant()@range</span></div>
                        </td>
                        <td class="mono small">@(s.IsSecret ? "(none)" : s.DefaultValue)</td>
                        <td class="small">
                            @if (s.IsSecret) { <span class="muted">@(string.IsNullOrEmpty(s.StoredValue) ? "not set" : "set (hidden)")</span> }
                            else if (s.StoredValue is null) { <span class="muted">default</span> }
                            else { <span class="mono">@s.StoredValue</span> }
                            @if (!string.IsNullOrEmpty(s.Note)) { <div class="muted">@s.Note</div> }
                            @if (s.UpdatedAt is not null) { <div class="muted">by @s.UpdatedBy, @Ui.Time(s.UpdatedAt)</div> }
                        </td>
                        <td class="mono small">@(s.IsSecret ? (string.IsNullOrEmpty(s.EffectiveValue) ? "not set" : "set (hidden)") : s.EffectiveValue)
                            @if (!s.IsSecret && s.StoredValue is not null && s.StoredValue != s.EffectiveValue) { <div><span class="badge amber">saved value is invalid; using the default</span></div> }
                        </td>
                        <td><div class="actions" style="justify-content:flex-end">
                            <button class="btn sm" type="button" data-open="set-@s.Section-@s.Key">Edit</button>
                            @if (s.StoredValue is not null)
                            {
                                <form method="post" asp-page-handler="Reset" data-confirm="Reset @s.Section:@s.Key to its default?">
                                    <input type="hidden" name="section" value="@s.Section" />
                                    <input type="hidden" name="key" value="@s.Key" />
                                    <button class="btn sm ghost" type="submit">Reset</button>
                                </form>
                            }
                            </div>
                            <dialog class="modal" id="set-@s.Section-@s.Key">
                                <form method="post" asp-page-handler="Set">
                                    <div class="modal-head"><h2 class="mono">@s.Section:@s.Key</h2><button class="icon-btn" type="button" data-close aria-label="Close">✕</button></div>
                                    <div class="modal-body">
                                        <p class="small muted">@s.Description Default: <span class="mono">@(s.IsSecret ? "(none)" : s.DefaultValue)</span> · @s.Type.ToLowerInvariant()@range</p>
                                        <input type="hidden" name="section" value="@s.Section" />
                                        <input type="hidden" name="key" value="@s.Key" />
                                        @if (s.IsSecret)
                                        {
                                            <input type="hidden" name="isSecret" value="true" />
                                            <div class="form-row"><label>New value</label><input type="password" name="value" autocomplete="new-password" placeholder="@(string.IsNullOrEmpty(s.StoredValue) ? "not set" : "set; type to replace")" maxlength="4000" required /></div>
                                        }
                                        else
                                        {
                                            <div class="form-row"><label>Value</label><input name="value" value="@s.StoredValue" placeholder="@s.DefaultValue" maxlength="4000" required /></div>
                                        }
                                        <div class="form-row"><label>Reason (optional)</label><input name="note" value="@s.Note" maxlength="1000" /></div>
                                    </div>
                                    <div class="modal-foot"><button class="btn" type="button" data-close>Cancel</button><button class="btn primary" type="submit">Save</button></div>
                                </form>
                            </dialog>
                        </td>
                    </tr>
                }
            </table>
        </div>
    }
}
