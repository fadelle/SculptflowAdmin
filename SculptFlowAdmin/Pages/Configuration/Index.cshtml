@page
@model SculptFlowAdmin.Pages.Configuration.IndexModel
@{
    ViewData["Title"] = "Configuration";
}
<div class="au-page-head">
    <p class="au-page-head__sub">The main app's settings, by section and key. A value saved here applies to every clinic, and the main app uses it at once.
        Without one, the built-in default applies. Secrets are never managed here; they stay in the server's environment.</p>
</div>

@if (Model.LoadError is null)
{
    <form class="filters au-toolbar" method="get">
        <div class="au-toolbar__filters">
            <div class="au-field" style="width:260px">
                <label class="au-label" for="f-q">Setting</label>
                <span class="au-input-icon"><span class="au-icon" aria-hidden="true">search</span><input class="au-input" type="search" id="f-q" name="q" value="@Model.Q" placeholder="e.g. Availability" /></span>
            </div>
            <label class="au-check"><input type="checkbox" name="changed" value="true" checked="@Model.ChangedOnly" /> Changed from default only</label>
        </div>
        <div class="au-toolbar__actions">
            <span class="au-toolbar__meta">@Ui.Count(Model.Sections.Sum(g => g.Count()), "setting", "settings")</span>
            <partial name="_FilterActions" />
        </div>
    </form>

    <div class="au-stack">
        @if (Model.Sections.Count == 0)
        {
            <div class="au-table-card">
                @{ var empty = new EmptyStateModel(Request.EmptyMessage("settings"), "settings_suggest"); }
                <partial name="_EmptyState" model="empty" />
            </div>
        }
        @foreach (var group in Model.Sections)
        {
            <section class="au-table-card">
                <div class="au-panel__head"><h3 class="au-panel__title au-mono">@group.Key</h3></div>
                <div class="au-table-scroll">
                    <table class="au-table">
                        <thead><tr><th>Key</th><th>Default</th><th>Saved value</th><th>In use now</th><th class="au-shrink"></th></tr></thead>
                        <tbody>
                            @foreach (var s in group)
                            {
                                var range = s.Min is null && s.Max is null ? "" : $" ({s.Min?.ToString("0.##")}–{s.Max?.ToString("0.##")})";
                                <tr>
                                    <td class="au-wrap" style="min-width:260px"><span class="au-mono au-strong">@s.Key</span>
                                        <div class="au-caption">@s.Description <span class="au-faint" style="white-space:nowrap">@s.Type.ToLowerInvariant()@range</span></div>
                                    </td>
                                    <td class="au-wrap"><span class="au-mono">@(s.IsSecret ? "(none)" : s.DefaultValue)</span></td>
                                    <td class="au-wrap">
                                        @if (s.IsSecret) { <span class="au-muted">@(string.IsNullOrEmpty(s.StoredValue) ? "not set" : "set (hidden)")</span> }
                                        else if (s.StoredValue is null) { <span class="au-muted">default</span> }
                                        else { <span class="au-mono">@s.StoredValue</span> }
                                        @if (!string.IsNullOrEmpty(s.Note)) { <div class="au-caption">@s.Note</div> }
                                        @if (s.UpdatedAt is not null) { <div class="au-caption">by @s.UpdatedBy, @Ui.Time(s.UpdatedAt)</div> }
                                    </td>
                                    <td class="au-wrap"><span class="au-mono">@(s.IsSecret ? (string.IsNullOrEmpty(s.EffectiveValue) ? "not set" : "set (hidden)") : s.EffectiveValue)</span>
                                        @if (!s.IsSecret && s.StoredValue is not null && s.StoredValue != s.EffectiveValue) { <div>@Ui.Badge("warning", "saved value is invalid; using the default")</div> }
                                    </td>
                                    <td>
                                        <span class="au-row-actions">
                                            <button class="au-btn au-btn--outlined au-btn--sm" type="button" data-open="set-@s.Section-@s.Key"><span class="au-icon" aria-hidden="true">edit</span>Edit</button>
                                            @if (s.StoredValue is not null)
                                            {
                                                <form method="post" asp-page-handler="Reset" data-confirm="Reset @s.Section:@s.Key to its default?">
                                                    <input type="hidden" name="section" value="@s.Section" />
                                                    <input type="hidden" name="key" value="@s.Key" />
                                                    <button class="au-btn au-btn--text au-btn--sm" type="submit">Reset</button>
                                                </form>
                                            }
                                        </span>
                                        @* inside a table cell: undo the cell's nowrap for the popup *@
                                        <dialog class="au-dialog au-dialog--sm" style="white-space:normal" id="set-@s.Section-@s.Key" aria-label="@s.Section:@s.Key">
                                            <form method="post" asp-page-handler="Set">
                                                <h2 class="au-dialog__title"><span class="au-mono">@s.Section:@s.Key</span><button class="au-icon-btn au-icon-btn--sm" type="button" data-close aria-label="Close"><span class="au-icon" aria-hidden="true">close</span></button></h2>
                                                <div class="au-dialog__content">
                                                    <p class="au-help" style="margin-bottom:16px">@s.Description Default: <span class="au-mono">@(s.IsSecret ? "(none)" : s.DefaultValue)</span> · @s.Type.ToLowerInvariant()@range</p>
                                                    <input type="hidden" name="section" value="@s.Section" />
                                                    <input type="hidden" name="key" value="@s.Key" />
                                                    <div class="au-stack" style="--au-gap:16px">
                                                        @if (s.IsSecret)
                                                        {
                                                            <input type="hidden" name="isSecret" value="true" />
                                                            <div class="au-form-field"><label class="au-form-label" for="cfg-value-@s.Section-@s.Key">New value<span class="au-required">*</span></label><input class="au-input" id="cfg-value-@s.Section-@s.Key" type="password" name="value" autocomplete="new-password" placeholder="@(string.IsNullOrEmpty(s.StoredValue) ? "not set" : "set; type to replace")" maxlength="4000" required /></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="au-form-field"><label class="au-form-label" for="cfg-value-@s.Section-@s.Key">Value<span class="au-required">*</span></label><input class="au-input au-mono" id="cfg-value-@s.Section-@s.Key" name="value" value="@s.StoredValue" placeholder="@s.DefaultValue" maxlength="4000" required /></div>
                                                        }
                                                        <div class="au-form-field"><label class="au-form-label" for="cfg-note-@s.Section-@s.Key">Reason (optional)</label><input class="au-input" id="cfg-note-@s.Section-@s.Key" name="note" value="@s.Note" maxlength="1000" /></div>
                                                    </div>
                                                </div>
                                                <div class="au-dialog__actions"><button class="au-btn" type="button" data-close>Cancel</button><button class="au-btn au-btn--primary" type="submit">Save</button></div>
                                            </form>
                                        </dialog>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
}
