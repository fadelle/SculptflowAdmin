@page
@model SculptFlowAdmin.Pages.UnavailableModel
@{
    ViewData["Title"] = "Main app unavailable";
}
<div class="card state">
    <h1>Couldn't load this page</h1>
    <p class="muted">This portal reads everything through the main app, and the main app didn't answer.</p>
    <div class="alert err">@Model.Reason</div>
    @if (Model.From is not null)
    {
        <div class="actions" style="justify-content:center"><a class="btn primary" href="@Model.From">Try again</a></div>
    }
</div>
