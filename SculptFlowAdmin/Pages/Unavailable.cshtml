@page
@model SculptFlowAdmin.Pages.UnavailableModel
@{
    ViewData["Title"] = "Main app unavailable";
}
<div class="page-head">
    <div><h1>Couldn't load this page</h1>
        <div class="muted">This portal reads everything through the main app, and the main app didn't answer.</div></div>
</div>
<div class="alert err">@Model.Reason</div>
@if (Model.From is not null)
{
    <a class="btn" href="@Model.From">Try again</a>
}
