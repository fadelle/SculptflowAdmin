@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="card state">
    <h1>Something went wrong</h1>
    <p class="muted">The page couldn't be shown. Try again, or go back to the dashboard.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small muted">Request ID: <span class="mono">@Model.RequestId</span></p>
    }
    <div class="actions" style="justify-content:center"><a class="btn primary" href="/">Dashboard</a></div>
</div>
