@page
@model SculptFlowAdmin.Pages.Messages.IndexModel
@{ ViewData["Title"] = "Messages"; }
<div class="au-page-head"><p class="au-page-head__sub">Every message in every clinic. Use "Failed only" to find delivery problems.</p></div>
<form class="filters au-toolbar" method="get">
    <div class="au-toolbar__filters">
        <partial name="_ClinicFilter" model="(Model.Clinics, Model.ClinicId)" />
        <div class="au-field" style="width:140px">
            <label class="au-label" for="f-sender">Sender</label>
            <select class="au-select" id="f-sender" name="sender"><option value="">All</option>
                @foreach (var s in new[] { "lead", "ai", "staff", "system" }) { <option value="@s" selected="@(s == Model.Sender)">@s</option> }
            </select>
        </div>
        <div class="au-field" style="width:240px">
            <label class="au-label" for="f-q">Text contains</label>
            <span class="au-input-icon"><span class="au-icon" aria-hidden="true">search</span><input class="au-input" type="search" id="f-q" name="q" value="@Model.Q" /></span>
        </div>
        <label class="au-check"><input type="checkbox" name="failed" value="true" checked="@Model.Failed" /> Failed only</label>
    </div>
    <div class="au-toolbar__actions">
        <span class="au-toolbar__meta">@Ui.Count(Model.Result.Total, "message", "messages")</span>
        <partial name="_FilterActions" />
    </div>
</form>
<div class="au-table-card">
    @if (Model.Result.Items.Count == 0)
    {
        var empty = new EmptyStateModel(Request.EmptyMessage("messages"), "send");
        <partial name="_EmptyState" model="empty" />
    }
    else
    {
        <div class="au-table-scroll">
            <table class="au-table">
                <thead>
                    <tr><th>When</th><th>Clinic</th><th>Channel</th><th>From</th><th>Message</th><th>Delivery</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Result.Items)
                    {
                        var text = m.Content ?? "(no text)";
                        <tr data-au-href="/Conversations/Details?id=@m.ConversationId">
                            <td>@Ui.Time(m.CreatedAt)</td>
                            <td><a href="/Clinics/Details?id=@m.ClinicId">@m.ClinicName</a></td>
                            <td>@m.Channel</td>
                            <td>@Ui.Badge(m.SenderType) <span class="au-caption">@m.Origin</span></td>
                            <td style="--au-col-max:380px" title="@Ui.Truncate(text, 600)"><a href="/Conversations/Details?id=@m.ConversationId">@Ui.Truncate(text, 140)</a></td>
                            <td>@Ui.Badge(m.DeliveryStatus)
                                @if (m.FailureReason is not null || m.FailureCode is not null) { <div class="au-caption au-text-error">@m.FailureCode @m.FailureReason</div> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="PagerModel.From(Model.Result)" />
</div>
