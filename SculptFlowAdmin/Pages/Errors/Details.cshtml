@page
@model SculptFlowAdmin.Pages.Errors.DetailsModel
@{
    var e = Model.Entry;
    ViewData["Title"] = e.Level + " in " + AppLogDisplay.Short(e.Category);
}
<div class="au-back-header">
    <a class="au-icon-btn au-icon-btn--bordered" href="/Errors/List?fingerprint=@e.Fingerprint" aria-label="Back to this problem's occurrences"><span class="au-icon" aria-hidden="true">arrow_back</span></a>
    <div style="min-width:0">
        <h2 class="au-back-header__title">@ViewData["Title"]</h2>
        <span class="au-back-header__sub">@Ui.Time(e.OccurredAt)@(e.RepeatCount > 1 ? " · stands for " + e.RepeatCount.ToString("N0") + " occurrences that minute" : "")</span>
    </div>
    <div class="au-row au-row--wrap">
        <a class="au-btn au-btn--outlined" href="/Errors/List?fingerprint=@e.Fingerprint&hours=2160">All occurrences</a>
        @if (e.TraceId is not null) { <a class="au-btn au-btn--outlined" href="/Errors/List?traceId=@e.TraceId&hours=2160">Same request</a> }
    </div>
</div>

<div class="au-stack">
    <section class="au-card">
        <div class="au-row au-row--wrap" style="margin-bottom:12px">@AppLogDisplay.Level(e.Level)</div>
        <p style="white-space:pre-wrap;word-break:break-word;margin:0">@e.Message</p>
    </section>

    <section class="au-card">
        <h3 class="au-h3">Where</h3>
        <div class="au-kv au-kv--2">
            <div class="au-kv__item"><span class="au-eyebrow">Logger</span><span class="au-kv__value au-mono">@e.Category</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Request</span><span class="au-kv__value au-mono">@Ui.OrDash(e.Route is null ? null : e.Method + " " + e.Route)</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Message template</span><span class="au-kv__value au-mono">@Ui.OrDash(e.MessageTemplate)</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Server</span><span class="au-kv__value">@Ui.OrDash(e.Instance)</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Trace id</span><span class="au-kv__value">@if (e.TraceId is null) { @Ui.OrDash(null) } else { <span class="au-copy"><span class="au-mono">@e.TraceId</span></span> }</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Problem (fingerprint)</span><span class="au-kv__value au-mono">@e.Fingerprint</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Clinic</span><span class="au-kv__value">@if (e.ClinicId.HasValue) { <a href="/Clinics/Details?id=@e.ClinicId">@Ui.Short(e.ClinicId.Value)</a> } else { @Ui.OrDash(null) }</span></div>
            <div class="au-kv__item"><span class="au-eyebrow">Conversation</span><span class="au-kv__value">@if (e.ConversationId.HasValue) { <a href="/Conversations/Details?id=@e.ConversationId">@Ui.Short(e.ConversationId.Value)</a> } else { @Ui.OrDash(null) }</span></div>
            @if (e.MessageId.HasValue)
            {
                <div class="au-kv__item"><span class="au-eyebrow">Message id</span><span class="au-kv__value au-mono">@e.MessageId</span></div>
            }
        </div>
    </section>

    @if (e.ExceptionType is not null)
    {
        <section class="au-card">
            <h3 class="au-h3">Exception</h3>
            <p class="au-mono" style="margin:0 0 8px">@e.ExceptionType</p>
            @if (!string.IsNullOrEmpty(e.ExceptionMessage)) { <p style="white-space:pre-wrap;word-break:break-word">@e.ExceptionMessage</p> }
            @if (!string.IsNullOrEmpty(e.StackTrace)) { <pre class="au-code" style="max-height:480px;overflow:auto">@e.StackTrace</pre> }
        </section>
    }

    @if (e.Properties.Count > 0)
    {
        <section class="au-table-card">
            <table class="au-table">
                <thead><tr><th>Logged value</th><th>Value</th></tr></thead>
                <tbody>
                    @foreach (var (key, value) in e.Properties.OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr><td class="au-mono">@key</td><td class="au-mono" style="--au-col-max:720px;white-space:pre-wrap;word-break:break-word">@Ui.OrDash(value)</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>