@page
@model SculptFlowAdmin.Pages.Staff.IndexModel
@{ ViewData["Title"] = "Staff accounts"; }
<div class="page-head"><div><h1>Staff accounts</h1><div class="muted">Clinic users of the main app. Admin users are separate (see Admin users).</div></div></div>
<form class="filters" method="get">
    <partial name="_ClinicFilter" model="(Model.Clinics, Model.ClinicId)" />
    <label class="search">Search<input type="search" name="q" value="@Model.Q" placeholder="Name or email" /></label>
    <partial name="_FilterActions" />
</form>
@if (Model.Result.Items.Count == 0)
{
    <div class="card empty">No staff accounts.</div>
}
else
{
<div class="table-wrap">
<table>
    <tr><th>Name</th><th>Clinic</th><th>Membership</th><th>Login</th><th>Sign-in methods</th><th>Joined</th></tr>
    @foreach (var s in Model.Result.Items)
    {
        <tr>
            <td><a href="/Staff/Details?id=@s.UserId">@(s.FullName ?? "(no name)")</a><div class="small muted">@s.Email</div></td>
            <td>@if (s.ClinicId.HasValue) { <a href="/Clinics/Details?id=@s.ClinicId">@s.ClinicName</a> } else { <span class="muted">no clinic</span> }</td>
            <td>@Ui.Badge(s.MembershipActive ? "active" : "inactive")</td>
            <td>@Ui.Badge(s.LoginLocked ? "locked" : "active", s.LoginLocked ? "locked" : "can sign in")</td>
            <td class="small">@(s.HasPassword ? "password" : "") @(s.HasGoogleLogin ? "Google" : "")</td>
            <td class="small">@Ui.Time(s.JoinedAt)</td>
        </tr>
    }
</table>
</div>
}
<partial name="_Pager" model="PagerModel.From(Model.Result)" />
