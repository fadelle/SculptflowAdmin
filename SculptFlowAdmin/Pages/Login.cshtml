@page
@model SculptFlowAdmin.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in · SculptFlow Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth">
    <form class="card" method="post">
        <h1>SculptFlow Admin</h1>
        <p class="muted">Admin accounts only. Clinic staff accounts can't sign in here.</p>
        @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert err">@Model.Error</div> }
        <div class="form-row"><label for="email">Email</label><input id="email" name="Email" type="email" value="@Model.Email" autocomplete="username" required autofocus /></div>
        <div class="form-row"><label for="pw">Password</label><input id="pw" name="Password" type="password" autocomplete="current-password" required /></div>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button class="btn primary" type="submit" style="width:100%">Sign in</button>
    </form>
</div>
</body>
</html>
