@page
@model SculptFlowAdmin.Pages.Procedures.IndexModel
@{ ViewData["Title"] = "Procedures"; }
<div class="page-head"><div><h1>Procedures</h1><div class="muted">Each clinic's service catalog. Inactive procedures are hidden from the AI and from booking.</div></div></div>
<form class="filters" method="get">
    <label class="search">Find<input type="search" data-filter="#rows" placeholder="Name, code or clinic" /></label>
    <partial name="_ClinicFilter" model="(Model.Clinics, Model.ClinicId)" />
    <partial name="_FilterActions" />
</form>
@if (Model.Rows.Count == 0)
{
    <div class="card empty">No procedures.</div>
}
else
{
<div class="table-wrap">
<table id="rows">
    <tr><th>Procedure</th><th>Clinic</th><th>Code</th><th class="num">Consultation (min)</th><th class="num">Leads interested</th><th>Status</th><th></th></tr>
    @foreach (var p in Model.Rows)
    {
        <tr>
            <td>@p.Name</td>
            <td><a href="/Clinics/Details?id=@p.ClinicId">@p.ClinicName</a></td>
            <td class="mono">@p.Code</td>
            <td class="num">@p.ConsultationDuration</td>
            <td class="num">@p.Leads</td>
            <td>@Ui.Badge(p.IsActive ? "active" : "inactive")</td>
            <td>
                <form method="post" asp-page-handler="SetActive" asp-route-clinicId="@Model.ClinicId">
                    <input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="active" value="@(!p.IsActive ? "true" : "false")" />
                    <button class="btn sm @(p.IsActive ? "danger" : "")" type="submit">@(p.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
</table>
</div>
}
