@page
@model SculptFlowAdmin.Pages.Billing.RateCardsModel
@{
    ViewData["Title"] = "Rate cards";
}
<div class="au-page-head">
    <p class="au-page-head__sub">Prices for usage SculptFlow charges, with the provider's cost beside each. A clinic is priced by its own custom card first, then its plan's card, then the default card.</p>
</div>

@if (Model.LoadError is null)
{
    <div class="au-stack">
        @if (!Model.Cards.Any(c => c.IsDefault && c.IsActive))
        {
            <div class="au-alert au-alert--warning" role="status">
                <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
                <div class="au-alert__body">There's no active default card. Every charged message is refused until some card prices it, so create a default card and its rates before billing is switched on.</div>
            </div>
        }
        <div class="au-table-card">
            @if (Model.Cards.Count == 0)
            {
                var empty = new EmptyStateModel("No rate cards yet.", "request_quote");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table">
                        <thead><tr><th>Card</th><th>Used for</th><th class="au-right">Current rates</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Cards.OrderByDescending(c => c.IsDefault).ThenBy(c => c.ClinicId is not null).ThenBy(c => c.Name))
                            {
                                var plans = Model.Plans.Where(p => p.RateCardCode == c.Code).Select(p => p.Name).ToList();
                                <tr data-au-href="/Billing/Rates?code=@c.Code">
                                    <td><a class="au-strong" href="/Billing/Rates?code=@c.Code">@c.Name</a> <div class="au-caption"><span class="au-mono">@c.Code</span>@if (c.Description is not null) { <text> · @c.Description</text> }</div></td>
                                    <td>
                                        @if (c.IsDefault) { @Ui.Badge("new", "default") }
                                        @if (c.ClinicId is not null) { <span>Custom prices for <a href="/Billing/Clinic?id=@c.ClinicId">@Model.ClinicName(c.ClinicId)</a></span> }
                                        @if (plans.Count > 0) { <span>Plans: @string.Join(", ", plans)</span> }
                                        @if (!c.IsDefault && c.ClinicId is null && plans.Count == 0) { <span class="au-muted">Not used by any plan yet</span> }
                                    </td>
                                    <td class="au-right">@c.CurrentRates</td>
                                    <td>@Ui.Badge(c.IsActive ? "active" : "inactive")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* Nothing on this page opens this popup today (no data-open="new-card"); kept as it was. *@
    <dialog class="au-dialog au-dialog--sm" id="new-card" aria-labelledby="new-card-title">
        <form method="post" asp-page-handler="Create">
            <h2 class="au-dialog__title" id="new-card-title">New rate card<button class="au-icon-btn au-icon-btn--sm" type="button" data-close aria-label="Close"><span class="au-icon" aria-hidden="true">close</span></button></h2>
            <div class="au-dialog__content">
                <div class="au-form-grid">
                    <div class="au-form-field au-span-2"><label class="au-form-label" for="nc-code">Code (lowercase, e.g. default or pro-prices)<span class="au-required">*</span></label><input class="au-input" id="nc-code" name="code" required pattern="[a-z0-9_\-]+" /></div>
                    <div class="au-form-field au-span-2"><label class="au-form-label" for="nc-name">Name<span class="au-required">*</span></label><input class="au-input" id="nc-name" name="name" required maxlength="100" /></div>
                    <div class="au-form-field au-span-2"><label class="au-form-label" for="nc-desc">Description (optional)</label><input class="au-input" id="nc-desc" name="description" maxlength="500" /></div>
                    <div class="au-form-field au-span-2"><label class="au-form-label" for="nc-clinic">Custom prices for one clinic (optional)</label>
                        <select class="au-select" id="nc-clinic" name="clinicId"><option value="">No: a default or plan card</option>
                            @foreach (var c in Model.Clinics) { <option value="@c.Id">@c.Name</option> }
                        </select></div>
                    <label class="au-check au-span-2"><input type="checkbox" name="isDefault" value="true" /> Make this the default card (replaces the current default)</label>
                </div>
                <p class="au-help" style="margin-top:12px">To use a card for a plan, pick it on the plan.</p>
            </div>
            <div class="au-dialog__actions"><button class="au-btn" type="button" data-close>Cancel</button><button class="au-btn au-btn--primary" type="submit">Create card</button></div>
        </form>
    </dialog>
}
