@page
@model SculptFlowAdmin.Pages.Billing.ReportModel
@{
    ViewData["Title"] = "Revenue report";
    var r = Model.Report;
    var cur = r?.Currency ?? "";
    string GroupUrl(string g) => $"?from={Model.From}&to={Model.To}&groupBy={g}";
}
<div class="au-page-head"><p class="au-page-head__sub">SculptFlow's billing revenue and costs for a period (dates in UTC). Usage counts only what counted at the provider.</p></div>

<form class="filters au-toolbar" method="get">
    <div class="au-toolbar__filters">
        <div class="au-field" style="width:170px"><label class="au-label" for="f-from">From</label><input class="au-input" id="f-from" type="date" name="from" value="@Model.From" /></div>
        <div class="au-field" style="width:170px"><label class="au-label" for="f-to">To (inclusive)</label><input class="au-input" id="f-to" type="date" name="to" value="@Model.To" /></div>
        <input type="hidden" name="groupBy" value="@Model.GroupBy" />
    </div>
    <div class="au-toolbar__actions">
        <button class="au-btn au-btn--primary" type="submit">Show</button>
        <button type="button" class="au-icon-btn au-icon-btn--bordered" data-au-refresh data-au-tip="Refresh" aria-label="Refresh"><span class="au-icon" aria-hidden="true">refresh</span></button>
    </div>
</form>

@if (r is not null)
{
    var totalRevenue = r.UsageRevenue + r.SubscriptionRevenue;
    <div class="au-stack">
        <div class="au-grid au-grid--4" style="--au-gap:12px">
            <div class="au-stat"><span class="au-eyebrow">Total revenue</span><div class="au-stat__value">@BillingUi.Money(totalRevenue)</div><div class="au-stat__hint">@cur · subscriptions + usage</div></div>
            <div class="au-stat"><span class="au-eyebrow">Subscription revenue</span><div class="au-stat__value">@BillingUi.Money(r.SubscriptionRevenue)</div><div class="au-stat__hint">@cur</div></div>
            <div class="au-stat"><span class="au-eyebrow">Usage revenue</span><div class="au-stat__value">@BillingUi.Money(r.UsageRevenue)</div><div class="au-stat__hint">@cur, after refunds</div></div>
            <div class="au-stat"><span class="au-eyebrow">Usage margin</span><div class="au-stat__value @(r.Margin < 0 ? "au-text-error" : null)">@BillingUi.Money(r.Margin)</div><div class="au-stat__hint">usage revenue − cost SculptFlow paid</div></div>
            <div class="au-stat"><span class="au-eyebrow">Provider cost paid by SculptFlow</span><div class="au-stat__value">@BillingUi.Money(r.ProviderCostPaidBySculptFlow)</div><div class="au-stat__hint">@cur</div></div>
            <div class="au-stat"><span class="au-eyebrow">Provider cost paid by clinics</span><div class="au-stat__value">@BillingUi.Money(r.ProviderCostPaidExternally)</div><div class="au-stat__hint">estimate, not SculptFlow money</div></div>
            <div class="au-stat"><span class="au-eyebrow">Wallet top-ups</span><div class="au-stat__value">@BillingUi.Money(r.TopUps)</div><div class="au-stat__hint">cash received</div></div>
        </div>

        <section class="au-table-card">
            <div class="au-tabs" style="padding:0 8px">
                <a class="au-tab @(Model.GroupBy == "clinic" ? "is-active" : null)" href="@GroupUrl("clinic")">By clinic</a>
                <a class="au-tab @(Model.GroupBy == "channel" ? "is-active" : null)" href="@GroupUrl("channel")">By channel</a>
                <a class="au-tab @(Model.GroupBy == "event" ? "is-active" : null)" href="@GroupUrl("event")">By event type</a>
                <a class="au-tab @(Model.GroupBy == "who_pays" ? "is-active" : null)" href="@GroupUrl("who_pays")">By who pays the provider</a>
            </div>
            @{ var groups = Model.Groups(); }
            @if (groups.Count == 0)
            {
                var empty = new EmptyStateModel("No usage in this period.", "monitoring");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table">
                        <thead>
                            <tr><th>@(Model.GroupBy switch { "channel" => "Channel", "event" => "Event type", "who_pays" => "Who pays the provider", _ => "Clinic" })</th>
                                <th class="au-right">Count</th><th class="au-right">Quantity</th><th class="au-right">Usage revenue</th><th class="au-right">Provider cost</th><th class="au-right">Margin</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var g in groups)
                            {
                                <tr>
                                    <td>@if (g.ClinicId is not null) { <a href="/Billing/Clinic?id=@g.ClinicId">@g.Label</a> } else { @g.Label }</td>
                                    <td class="au-right">@g.Count.ToString("N0")</td>
                                    <td class="au-right">@BillingUi.Number(g.Quantity)</td>
                                    <td class="au-right">@BillingUi.Money(g.Revenue)</td>
                                    <td class="au-right">@BillingUi.Money(g.ProviderCost)</td>
                                    <td class="au-right @(g.Margin < 0 ? "au-text-error" : null)">@BillingUi.Money(g.Margin)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th>Total (@cur)</th><th class="au-right">@groups.Sum(g => g.Count).ToString("N0")</th><th class="au-right">@BillingUi.Number(groups.Sum(g => g.Quantity))</th>
                                <th class="au-right">@BillingUi.Money(groups.Sum(g => g.Revenue))</th><th class="au-right">@BillingUi.Money(groups.Sum(g => g.ProviderCost))</th><th class="au-right">@BillingUi.Money(groups.Sum(g => g.Margin))</th></tr>
                        </tfoot>
                    </table>
                </div>
                <div class="au-pager"><span class="au-pager__count">Provider cost includes cost clinics paid directly (where known); margin only subtracts cost SculptFlow paid.</span></div>
            }
        </section>
    </div>
}
