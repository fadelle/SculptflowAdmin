@page
@model SculptFlowAdmin.Pages.Billing.PlansModel
@{
    ViewData["Title"] = "Plans";
    var e = Model.Editing;
}
<div class="page-head">
    <div><h1>Plans</h1>
        <div class="muted">What a clinic pays SculptFlow for access, the usage credit it includes each period, and which features and limits it unlocks.</div></div>
    @if (e is not null) { <a class="btn" href="/Billing/Plans">New plan</a> }
</div>

@if (Model.LoadError is null)
{
    @if (Model.Plans.Count == 0)
    {
        <div class="card empty">No plans yet. Create the first one below.</div>
    }
    else
    {
        <div class="table-wrap" style="margin-bottom:16px">
            <table>
                <tr><th>Plan</th><th class="num">Price</th><th class="num">Included credit</th><th>Rate card</th><th>Features &amp; limits</th><th class="num">Subscribers</th><th>Status</th><th></th></tr>
                @foreach (var p in Model.Plans.OrderBy(p => p.SortOrder).ThenBy(p => p.Name))
                {
                    <tr>
                        <td><strong>@p.Name</strong> <div class="small muted mono">@p.Code</div>@if (p.Description is not null) { <div class="small muted">@p.Description</div> }</td>
                        <td class="num nowrap">@BillingUi.Money(p.Price, p.Currency) <div class="small muted">per @p.BillingPeriod</div></td>
                        <td class="num">@BillingUi.Money(p.IncludedUsageCredit)</td>
                        <td>@if (p.RateCardCode is null) { <span class="muted">default</span> } else { <a href="/Billing/Rates?code=@p.RateCardCode">@p.RateCardCode</a> }</td>
                        <td class="small">
                            @foreach (var d in Model.Catalog)
                            {
                                var has = p.Entitlements.TryGetValue(d.Key, out var v);
                                if (d.Kind == "feature") { if (has && v == "true") { <span class="badge green">@d.Label</span> } }
                                else { <span class="badge">@d.Label: @(has ? v : "0")</span> }
                            }
                        </td>
                        <td class="num">@p.Subscribers</td>
                        <td>@Ui.Badge(p.IsActive ? "active" : "inactive")</td>
                        <td><a class="btn sm" href="/Billing/Plans?edit=@p.Code">Edit</a></td>
                    </tr>
                }
            </table>
        </div>
    }

    <form class="card" method="post" asp-page-handler="Save">
        <h2>@(e is null ? "New plan" : $"Edit {e.Name}")</h2>
        @if (e is not null)
        {
            <input type="hidden" name="originalCode" value="@e.Code" />
            <p class="small muted">Changes to price and included credit apply from each subscriber's next renewal. The code can't change.</p>
        }
        <div class="grid grid-2" style="gap:0 24px">
            <div>
                <div class="form-row"><label>Code (lowercase, e.g. starter)</label><input name="code" value="@e?.Code" required pattern="[a-z0-9_\-]+" disabled="@(e is not null)" /></div>
                <div class="form-row"><label>Name</label><input name="name" value="@e?.Name" required maxlength="100" /></div>
                <div class="form-row"><label>Description (optional)</label><input name="description" value="@e?.Description" maxlength="500" /></div>
                <div class="form-row"><label>Sort order</label><input type="number" name="sortOrder" value="@(e?.SortOrder ?? 0)" /></div>
                <div class="form-row"><label><input type="checkbox" name="isActive" value="true" checked="@(e?.IsActive ?? true)" /> Active (offered for new subscriptions)</label></div>
            </div>
            <div>
                <div class="form-row"><label>Price per period</label><input type="number" name="price" min="0" step="0.01" value="@(e is null ? "0" : BillingUi.Input(e.Price))" required /></div>
                <div class="form-row"><label>Billing period</label>
                    <select name="billingPeriod">@foreach (var bp in BillingVocab.BillingPeriods) { <option value="@bp" selected="@(bp == (e?.BillingPeriod ?? "month"))">@bp</option> }</select></div>
                <div class="form-row"><label>Included usage credit per period (money, spent before the wallet)</label><input type="number" name="includedUsageCredit" min="0" step="0.01" value="@(e is null ? "0" : BillingUi.Input(e.IncludedUsageCredit))" required /></div>
                <div class="form-row"><label>Rate card (blank = the default card)</label>
                    <select name="rateCardCode"><option value="">Default card</option>
                        @foreach (var rc in Model.RateCards.Where(c => c.ClinicId is null && !c.IsDefault)) { <option value="@rc.Code" selected="@(rc.Code == e?.RateCardCode)">@rc.Name (@rc.Code)</option> }
                    </select></div>
            </div>
        </div>
        <h2 style="margin-top:8px">Features &amp; limits</h2>
        <p class="small muted">A feature that isn't ticked is off. A limit is a whole number or "unlimited"; blank means 0.</p>
        <div class="ent-grid" style="margin-bottom:12px">
            @foreach (var d in Model.Catalog)
            {
                var value = e is not null && e.Entitlements.TryGetValue(d.Key, out var v2) ? v2 : null;
                if (d.Kind == "feature")
                {
                    <label class="form-row"><input type="checkbox" name="ent:@d.Key" value="true" checked="@(value == "true")" /> @d.Label</label>
                }
                else
                {
                    <div class="form-row"><label>@d.Label</label><input name="ent:@d.Key" value="@value" placeholder="0" pattern="[0-9]+|unlimited" /></div>
                }
            }
        </div>
        <button class="btn primary" type="submit">@(e is null ? "Create plan" : "Save plan")</button>
        @if (e is not null) { <a class="btn" href="/Billing/Plans">Cancel</a> }
    </form>
}
