@page
@model SculptFlowAdmin.Pages.Billing.RatesModel
@{
    var c = Model.Card;
    ViewData["Title"] = (c?.Name ?? "Rate card") + " · Rates";
    var now = DateTimeOffset.UtcNow;
}
<div class="page-head">
    <div>
        <h1>@(c?.Name ?? "Rate card") <span class="muted small mono">@c?.Code</span></h1>
        <div class="muted small"><a href="/Billing/RateCards">All rate cards</a>
            @if (c is not null) { <span> · @Ui.Badge(c.IsActive ? "active" : "inactive") @if (c.IsDefault) { @Ui.Badge("new", "default") }</span> }</div>
    </div>
</div>

@if (c is not null && Model.LoadError is null)
{
    <div class="card">
        <div class="page-head" style="margin-bottom:8px">
            <h2 style="margin:0">@(Model.History ? "All rate versions" : "Current and upcoming rates")</h2>
            <a class="btn sm" href="?code=@c.Code&history=@(!Model.History)">@(Model.History ? "Hide past versions" : "Show past versions")</a>
        </div>
        <p class="small muted">A rate is never edited: add a new version and the old one ends when it starts, so past usage keeps its price. The most specific rate wins (country, then operator, then provider, then who pays the provider). "Who pays: any" rates price usage SculptFlow pays the provider for; a rate for a customer-paid mode is a SculptFlow usage fee.</p>
        @if (Model.Rates.Count == 0)
        {
            <div class="empty">No rates on this card yet.</div>
        }
        else
        {
            <div class="table-wrap">
            <table>
                <tr><th>Event</th><th>Country</th><th>Operator</th><th>Provider</th><th>Who pays the provider</th><th class="num">Provider cost</th><th class="num">Client rate</th><th class="num">Margin</th><th>Effective</th><th>Notes</th><th></th></tr>
                @foreach (var r in Model.Rates.OrderBy(r => r.EventType).ThenBy(r => r.CountryCode).ThenBy(r => r.EffectiveFrom))
                {
                    var current = r.EffectiveFrom <= now && (r.EffectiveTo is null || r.EffectiveTo > now);
                    var upcoming = r.EffectiveFrom > now;
                    <tr style="@(current || upcoming ? "" : "opacity:.6")">
                        <td>@BillingUi.EventLabel(r.EventType) <div class="small muted">per @r.Unit</div></td>
                        <td>@(r.CountryCode ?? "any")</td>
                        <td>@(r.Operator ?? "any")</td>
                        <td>@(r.Provider ?? "any")</td>
                        <td class="small">@BillingUi.ResponsibilityLabel(r.ProviderBilling)</td>
                        <td class="num">@BillingUi.Money(r.ProviderCost)</td>
                        <td class="num"><strong>@BillingUi.Money(r.ClientRate)</strong></td>
                        <td class="num @(r.Margin < 0 ? "neg" : "")">@BillingUi.Money(r.Margin)</td>
                        <td class="small">@Ui.Time(r.EffectiveFrom) → @if (r.EffectiveTo is null) { <span>open</span> } else { @Ui.Time(r.EffectiveTo) }
                            <div>@Ui.Badge(current ? "active" : upcoming ? "scheduled" : "inactive", current ? "current" : upcoming ? "upcoming" : "ended")</div></td>
                        <td class="small">@r.Notes @if (r.CreatedBy is not null) { <div class="muted">by @r.CreatedBy</div> }</td>
                        <td>
                            @if (current || upcoming)
                            {
                                <form method="post" asp-page-handler="CloseRate" asp-route-code="@c.Code" asp-route-history="@Model.History">
                                    <input type="hidden" name="rateId" value="@r.Id" />
                                    <button class="btn sm danger" type="submit" data-confirm="End this rate now? Usage it priced keeps its price; new usage falls back to the next matching rate.">End now</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </table>
            </div>
            <div class="small muted" style="margin-top:6px">Amounts in @(Model.Rates.First().Currency).</div>
        }
    </div>

    <div class="grid grid-2">
        <form class="card" method="post" asp-page-handler="AddRate" asp-route-code="@c.Code" asp-route-history="@Model.History">
            <h2>Add a rate (or a new version of one)</h2>
            <div class="form-row"><label>Event type</label><input name="eventType" list="event-types" required /></div>
            <datalist id="event-types">@foreach (var e in BillingVocab.EventTypes) { <option value="@e"></option> }</datalist>
            <div class="form-row"><label>Country (ISO 2, blank = any)</label><input name="countryCode" maxlength="2" /></div>
            <div class="form-row"><label>Operator (blank = any)</label><input name="operator" maxlength="100" /></div>
            <div class="form-row"><label>Provider (e.g. infobip, meta; blank = any)</label><input name="provider" maxlength="50" /></div>
            <div class="form-row"><label>Who pays the provider</label>
                <select name="providerBilling">
                    <option value="">Any: SculptFlow-funded price</option>
                    @foreach (var m in Model.Modes?.Modes ?? []) { if (m.Value != "platform_funded") { <option value="@m.Value">@m.Label (usage fee)</option> } }
                    <option value="platform_funded">SculptFlow pays provider only</option>
                </select></div>
            <div class="form-row"><label>Unit (blank = the event's usual unit)</label><input name="unit" maxlength="30" placeholder="message, segment, minute…" /></div>
            <div class="form-row"><label>Provider cost per unit</label><input type="number" name="providerCost" min="0" step="0.000001" value="0" required /></div>
            <div class="form-row"><label>Client rate per unit (what SculptFlow charges)</label><input type="number" name="clientRate" min="0" step="0.000001" required /></div>
            <div class="form-row"><label>Effective from (UTC, blank = now; can't be in the past)</label><input type="datetime-local" name="effectiveFrom" /></div>
            <div class="form-row"><label>Notes (optional)</label><input name="notes" maxlength="500" /></div>
            <button class="btn primary" type="submit" data-confirm="Add this rate? It can't be edited afterwards, only replaced by a new version.">Add rate</button>
        </form>

        <form class="card" method="post" asp-page-handler="UpdateCard" asp-route-code="@c.Code" asp-route-history="@Model.History">
            <h2>Card details</h2>
            <div class="form-row"><label>Name</label><input name="name" value="@c.Name" required maxlength="100" /></div>
            <div class="form-row"><label>Description</label><input name="description" value="@c.Description" maxlength="500" /></div>
            <div class="form-row"><label><input type="checkbox" name="isActive" value="true" checked="@c.IsActive" /> Active</label></div>
            @if (c.ClinicId is null)
            {
                <div class="form-row"><label><input type="checkbox" name="isDefault" value="true" checked="@c.IsDefault" /> Default card</label></div>
            }
            else
            {
                <p class="small">Custom prices for <a href="/Billing/Clinic?id=@c.ClinicId">this clinic</a>.</p>
            }
            <button class="btn" type="submit">Save card</button>
        </form>
    </div>
}
